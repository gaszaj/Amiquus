    }

    #features .map-svg .node rect {
      rx: 16;
      ry: 16;
      width: 240px;
      height: 108px;
      x: -120;
      y: -54;
    }

    #features .map-svg .node--center circle {
      fill: radial-gradient(
        circle at 30% 0%,
        hsl(var(--primary) / 0.45),
        hsl(var(--primary) / 0.06)
      );
      stroke: hsl(var(--primary));
      stroke-width: 2;
    }

    #features .map-svg .center-logo {
      filter:
        drop-shadow(0 0 18px hsl(var(--primary) / 0.6))
        drop-shadow(0 8px 20px rgba(0, 0, 0, 0.45));
    }

    #features .map-svg .center-title {
      font: 900 18px/1 var(--font-sans, system-ui, -apple-system, BlinkMacSystemFont,
          'Inter');
      text-anchor: middle;
      fill: rgb(var(--foreground));
      text-decoration: underline;
      text-decoration-thickness: 0.1em;
      text-underline-offset: 3px;
      text-decoration-color: hsl(var(--primary));
    }

    #features .map-svg .center-sub {
      font: 700 17px/1 var(--font-sans, system-ui, -apple-system, BlinkMacSystemFont,
          'Inter');
      text-anchor: middle;
      fill: rgb(var(--muted-foreground));
    }

    #features .map-svg .node .t1 {
      font: 800 clamp(14px, 1.4vw, 16px) / 1.1 var(--font-sans, system-ui,
          -apple-system, BlinkMacSystemFont, 'Inter');
      text-anchor: middle;
      dominant-baseline: central;
      fill: rgb(var(--foreground));
      text-decoration: underline;
      text-decoration-thickness: 0.08em;
      text-underline-offset: 2px;
      text-decoration-color: hsl(var(--primary));
    }

    #features .map-svg .node .t2 {
      font: 600 clamp(12px, 1.2vw, 14px) / 1.2 var(--font-sans, system-ui,
          -apple-system, BlinkMacSystemFont, 'Inter');
      text-anchor: middle;
      dominant-baseline: central;
      fill: rgb(var(--muted-foreground));
    }

    /* subtle float animation on cards */
    @keyframes amq-node-float {
      0% {
        transform: translate3d(0, 0, 0) rotate(0deg);
      }
      25% {
        transform: translate3d(var(--x1, 6px), var(--y1, -8px), 0)
          rotate(var(--r1, -0.5deg));
      }
      50% {
        transform: translate3d(var(--x2, -9px), var(--y2, -10px), 0)
          rotate(var(--r2, 0.7deg));
      }
      75% {
        transform: translate3d(var(--x3, 9px), var(--y3, 6px), 0)
          rotate(var(--r3, -0.4deg));
      }
      100% {
        transform: translate3d(0, 0, 0) rotate(0deg);
      }
    }

    #features .node.is-clickable .float {
      transform-box: fill-box;
      transform-origin: center;
      animation: amq-node-float var(--dur, 7.2s) ease-in-out infinite;
      animation-delay: var(--delay, 0s);
      will-change: transform;
    }

    #features .node.is-clickable rect {
      cursor: pointer;
      transition:
        transform 0.18s ease,
        filter 0.18s ease,
        stroke 0.18s ease,
        box-shadow 0.18s ease;
    }

    #features .node.is-clickable:hover rect,
    #features .node.is-clickable:focus rect {
      transform: translateY(-3px);
      filter: drop-shadow(0 10px 28px rgba(0, 0, 0, 0.3));
      stroke: #fff;
    }

    #features .node text {
      pointer-events: none;
    }

    /* hint chip */
    #features .map-hint {
      position: absolute;
      top: 0.75rem;
      right: 0.75rem;
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
      padding: 0.55rem 0.8rem;
      border-radius: 999px;
      font: 600 0.85rem/1.1 var(--font-sans, system-ui, -apple-system,
          BlinkMacSystemFont, 'Inter');
      letter-spacing: 0.01em;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
      z-index: 5;
      background: linear-gradient(
        135deg,
        hsl(var(--primary)) 0%,
        hsl(var(--primary) / 0.2) 100%
      );
      color: #fff;
      border: 1px solid hsl(var(--primary) / 0.9);
    }

    #features .map-hint__label {
      font: 700 0.72rem/1 var(--font-sans, system-ui, -apple-system,
          BlinkMacSystemFont, 'Inter');
      padding: 0.15rem 0.45rem;
      border-radius: 0.5rem;
      border: 1px solid currentColor;
      opacity: 0.9;
    }

    /* modal */
    #features .map-modal {
      position: fixed;
      inset: 0;
      display: none;
      z-index: 50;
    }

    #features .map-modal[aria-hidden='false'] {
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 2rem;
    }

    #features .map-modal__backdrop {
      position: absolute;
      inset: 0;
      background: rgba(0, 0, 0, 0.55);
    }

    #features .map-modal__panel {
      position: relative;
      z-index: 2;
      width: min(92vw, 40rem);
      max-height: min(85vh, 720px);
      overflow: auto;
      border-radius: 1rem;
      border: 1px solid rgb(var(--border));
      background: rgb(var(--card));
      color: rgb(var(--foreground));
      box-shadow: 0 24px 80px rgba(0, 0, 0, 0.28);
      padding: 1.25rem 1.5rem;
    }

    #features .map-modal__title {
      font: 800 1.25rem/1.2 var(--font-sans, system-ui, -apple-system,
          BlinkMacSystemFont, 'Inter');
      margin: 0 2rem 0.45rem 0;
    }

    #features .map-modal__sub {
      margin: 0.125rem 0 0.9rem;
      color: rgb(var(--muted-foreground));
    }

    #features .map-modal__body {
      line-height: 1.55;
      font-size: 0.95rem;
    }

    #features .map-modal__close {
      position: absolute;
      top: 0.5rem;
      right: 0.5rem;
      width: 2rem;
      height: 2rem;
      border: none;
      border-radius: 0.5rem;
      background: transparent;
      color: inherit;
      font-size: 1.5rem;
      cursor: pointer;
    }

    #features .map-modal__close:hover {
      background: rgba(0, 0, 0, 0.06);
    }

    /* small inline icons for coverage notes */
    #features .i-badge,
    #features .i-shield {
      width: 1.15rem;
      height: 1.15rem;
      border-radius: 999px;
      border: 1px solid rgb(var(--border));
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 0.7rem;
      background: rgb(var(--card));
    }

    #features .i-badge::before {
      content: '✓';
      color: hsl(var(--primary));
      font-weight: 700;
    }

    #features .i-shield::before {
      content: '🛡️';
      font-size: 0.8rem;
    }

    @media (max-width: 860px) {
      #features .map-wrap {
        padding: calc(
            clamp(1rem, 3.2vw, 1.75rem) + 44px
          )
          clamp(1rem, 4vw, 1.5rem)
          clamp(1rem, 3.2vw, 1.75rem);
      }

      #features .map-hint {
        top: clamp(0.5rem, 2.2vw, 0.75rem);
        right: clamp(0.5rem, 2.2vw, 0.75rem);
        padding: 0.45rem 0.65rem;
      }

      #features .map-svg {
        max-height: 380px;
      }
    }

    @media (max-width: 640px) {
      #features .map-svg .node rect {
        height: 114px;
        y: -57;
      }

      #features .map-svg .node .t1 {
        font-size: 17px;
        font-weight: 900;
        transform: translateY(-12px);
      }

      #features .map-svg .node .t2 {
        font-size: 14px;
        font-weight: 700;
        transform: translateY(12px);
      }

      #features .map-svg .center-title,
      #features .map-svg .center-sub {
        font-size: 19px;
      }
    }
  </style>

  <!-- JavaScript for the features modal -->
  <script>
    (function () {
      const modal = document.getElementById('amqFeatureModal');
      if (!modal) return;

      const titleEl = document.getElementById('amqFeatureModalTitle');
      const subEl = document.getElementById('amqFeatureModalSub');
      const bodyEl = document.getElementById('amqFeatureModalBody');

      let lastFocused = null;

      function openModal(data) {
        lastFocused = document.activeElement instanceof HTMLElement ? document.activeElement : null;

        titleEl.textContent = data.title || '';
        subEl.textContent = data.sub || '';
        bodyEl.textContent = data.body || '';

        modal.setAttribute('aria-hidden', 'false');
        const closeBtn = modal.querySelector('.map-modal__close');
        closeBtn && closeBtn.focus({ preventScroll: true });

        document.addEventListener('keydown', onEsc);
      }

      function closeModal() {
        modal.setAttribute('aria-hidden', 'true');
        document.removeEventListener('keydown', onEsc);
        if (lastFocused && typeof lastFocused.focus === 'function') {
          lastFocused.focus({ preventScroll: true });
        }
      }

      function onEsc(e) {
        if (e.key === 'Escape') closeModal();
      }

      modal.addEventListener('click', (e) => {
        if (e.target.matches('[data-close], .map-modal__backdrop')) {
          e.preventDefault();
          closeModal();
        }
      });

      document
        .querySelectorAll('#features .hero-map .node.is-clickable')
        .forEach((node) => {
          const rect = node.querySelector('rect');

          // float randomization per node
          const float = node.querySelector('.float');
          if (float) {
            const rnd = (min, max) => Math.random() * (max - min) + min;
            const sign = () => (Math.random() < 0.5 ? -1 : 1);

            float.style.setProperty('--x1', `${sign() * rnd(6, 14)}px`);
            float.style.setProperty('--y1', `${-rnd(6, 12)}px`);
            float.style.setProperty('--r1', `${sign() * rnd(0.4, 1.4)}deg`);

            float.style.setProperty('--x2', `${sign() * rnd(6, 14)}px`);
            float.style.setProperty('--y2', `${-rnd(6, 14)}px`);
            float.style.setProperty('--r2', `${sign() * rnd(0.4, 1.4)}deg`);

            float.style.setProperty('--x3', `${sign() * rnd(6, 14)}px`);
            float.style.setProperty('--y3', `${rnd(6, 14)}px`);
            float.style.setProperty('--r3', `${sign() * rnd(0.4, 1.4)}deg`);

            float.style.setProperty('--dur', `${rnd(6.2, 9.1).toFixed(2)}s`);
            float.style.setProperty('--delay', `${rnd(0, 1.4).toFixed(2)}s`);
          }

          const open = () =>
            openModal({
              title: node.getAttribute('data-title') || '',
              sub: node.getAttribute('data-sub') || '',
              body: node.getAttribute('data-body') || '',
            });

          if (rect) rect.addEventListener('click', open);
          node.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' || e.key === ' ') {
              e.preventDefault();
              open();
            }
          });
        });
    })();
  </script>
</BaseLayout>
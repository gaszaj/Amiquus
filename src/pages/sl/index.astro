---
import path from 'path';
import Database from 'better-sqlite3';
import BaseLayout from '../../layouts/BaseLayout.astro';

// -----------------------------------------------------------------------------
//  Multi‑language homepage for Amiquus
//
//  This Astro page consumes data from a SQLite database (`src/data/data.db`) in
//  exactly the same way the reference project does.  All user‑facing strings
//  (hero headlines, meta descriptions, CTA labels, etc.) live in the `home`
//  table of the database.  Nothing is hard coded: if you need to update
//  copy or translate it into another language just edit the corresponding
//  row in the `home.json` file and regenerate `data.db`.
//
//  The page also constructs rich Schema.org objects for improved SEO.  See
//  `webpageSchema` and `organizationSchema` below for details.  Additional
//  schemas (FAQPage, HowTo, etc.) can easily be added by extending the
//  `schema` array.
//
//  All large CSS and JS blocks are consolidated at the bottom of this file.
// -----------------------------------------------------------------------------

// Determine the locale from the URL (e.g. "/en", "/si", "/hr").  Fallback to
// "en" if the first segment is empty.
const locale = Astro.url.pathname.split('/')[1] || 'en';

// Open a read‑only connection to the SQLite database.  The database should
// contain at least the `home`, `common`, `www` and `locale` tables.  Each
// language (en, si, hr) should have a corresponding row in `home`.
const dbPath = path.join(process.cwd(), 'src/data/data.db');
const db = new Database(dbPath, { readonly: true });

// Fetch all required data in a single transaction.  If any essential table
// is missing or the locale doesn’t exist in the `home` table we redirect to
// a 404 page.
const { home, common, www, locales } = db.transaction(() => {
  const homeRow = db.prepare('SELECT * FROM home WHERE M_SLUG = ?').get(locale);
  const commonRow = db.prepare('SELECT * FROM common WHERE M_SLUG = ?').get(locale);
  const wwwRow = db.prepare('SELECT * FROM www LIMIT 1').get();
  const localeRows = db.prepare(
    'SELECT M_SLUG, M_LANGUAGE_ISO FROM locale WHERE M_LOCALE_PUBLISH_Y_N = ?'
    ).all('1');
  return { home: homeRow, common: commonRow, www: wwwRow, locales: localeRows };
})();

// If no matching locale or common row exists then we can’t render anything.
if (!home || !common) {
  return Astro.redirect('/404');
}

// Basic language and orientation metadata.  These are passed to BaseLayout so
// that the document <html> tag can include the correct `lang`, `dir` and other
// attributes.
const languageIso: string = home.M_LANGUAGE_ISO;
const countryCode: string = home.M_COUNTRY_CODE;
const contentOrientation: string = common.M_CONTENT_ORIENTATION || 'ltr';

// Helpers to generate absolute URLs.  We use `getBaseUrl()` for generating
// canonical URLs and to build image paths for Schema.org objects.
const getBaseUrl = (p: string) => new URL(p, Astro.url.origin).toString();

// Title, description and Open‑Graph image come from the database.  These
// populate the <title>, <meta name="description"> and og:image tags via
// BaseLayout.
const pageTitle: string = home.HOME_H1;
const pageDescription: string | undefined = home.HOME_META_SEO;
const pageOgImage: string | undefined = home.HOME_OG_IMAGE_PATH;

// Keywords can be customised via the `common` table.  Join non‑empty values
// with commas to produce a single string.  Feel free to extend this list.
const pageKeywords: string = [
  home.HOME_H1,
  common.M_COUNTRY_NATIVE,
  www.PAGE_ORGANISATION_FULL_NAME
].filter(Boolean).join(', ');

// Build a language switcher map.  Each key is a locale slug (e.g. "en") and
// each value is the URL for that locale (e.g. "/en").  BaseLayout uses this
// to render hreflang link tags.
const languageLinksMap: Record<string, string> = {};
for (const row of locales) {
  languageLinksMap[row.M_SLUG] = `/${row.M_SLUG}`;
}

// -----------------------------------------------------------------------------
// Structured Data (Schema.org)
//
// We prepare WebPage and Organization schema objects.  If you wish to add
// FAQPage, HowTo, BreadcrumbList or any other schema, simply extend the
// `schema` array with additional objects following the examples below.  See
// https://schema.org/docs/schemas.html for more details.
// -----------------------------------------------------------------------------
// FAQ items and schema.  Up to three Q/A pairs are defined in the database.
const faqItems = [
  { question: home.FAQ_Q1, answer: home.FAQ_A1 },
  { question: home.FAQ_Q2, answer: home.FAQ_A2 },
  { question: home.FAQ_Q3, answer: home.FAQ_A3 }
].filter(item => item.question && item.answer);
const faqSchema = faqItems.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqItems.map(item => ({
    '@type': 'Question',
    'name': item.question,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': item.answer
    }
  }))
} : null;

const webpageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  'name': home.HOME_H1,
  'url': Astro.url.href,
  'description': home.HOME_META_SEO,
  'inLanguage': `${languageIso}-${countryCode}`,
  'breadcrumb': {
    '@type': 'BreadcrumbList',
    'itemListElement': [
      {
        '@type': 'ListItem',
        'position': 1,
        'name': home.HOME_H1,
        'item': Astro.url.href
      }
    ]
  },
  'mainEntity': {
    '@type': 'Article',
    'headline': home.HOME_H1,
    'description': home.HOME_META_SEO,
    'image': getBaseUrl(home.HOME_OG_IMAGE_PATH),
    'author': {
      '@type': 'Organization',
      'name': www.PAGE_ORGANISATION_FULL_NAME
    },
    'datePublished': `${home.HOME_DATE_PUBLISHED || ''}T${home.HOME_HOUR_PUBLISHED || '00:00:00'}+02:00`,
    'dateModified': `${home.HOME_DATE_UPDATED || ''}T${home.HOME_HOUR_UPDATED || '00:00:00'}+02:00`,
    'inLanguage': `${languageIso}-${countryCode}`
  }
};

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  'name': www.PAGE_ORGANISATION_FULL_NAME,
  'url': getBaseUrl('/'),
  'logo': getBaseUrl(www.PAGE_LOGO_IMAGE_PATH_1 || ''),
  'foundingDate': www.PAGE_FOUNDING_DATE,
  'slogan': common.PAGE_SLOGAN,
  'description': common.PAGE_SLOGAN,
  'keywords': [
    www.PAGE_ORGANISATION_FULL_NAME,
    common.M_COUNTRY_NATIVE,
    common.PAGE_KEYWORD_1,
    common.PAGE_KEYWORD_2,
    common.PAGE_KEYWORD_3,
    common.PAGE_KEYWORD_4,
    common.PAGE_KEYWORD_5,
    common.PAGE_KEYWORD_6
  ].filter(Boolean),
  'contactPoint': {
    '@type': 'ContactPoint',
    'email': www.PAGE_INFO_EMAIL,
    'contactType': common.M_CUSTOMER_SUPPORT
  },
  'sameAs': [
    www.PAGE_INSTAGRAM_URL,
    www.PAGE_FACEBOOK_URL,
    www.PAGE_TWITTER_URL,
    www.PAGE_LINKEDIN_URL,
    www.PAGE_YOUTUBE_URL,
    www.PAGE_PINTEREST_URL,
    www.PAGE_BLUESKY_URL
  ].filter(Boolean),
  'areaServed': {
    '@type': 'Country',
    'name': common.M_COUNTRY,
    'identifier': common.M_COUNTRY_CODE
  }
};

// Include the FAQ schema if available.  Additional schemas can be appended
// here by extending the array.
const schema: object[] = faqSchema ? [webpageSchema, organizationSchema, faqSchema] : [webpageSchema, organizationSchema];

// -----------------------------------------------------------------------------
//  Derive content variables from the `home` row.  These variables are used
//  throughout the template.  You can add or remove variables depending on
//  what data you choose to store in the database.
// -----------------------------------------------------------------------------

// Hero section
const heroTitlePart1: string = home.HOME_TITLE_PART1 || '';
const heroHighlight: string = home.HOME_HIGHLIGHT || '';
const heroTitlePart2: string = home.HOME_TITLE_PART2 || '';
const heroSubtitle: string = home.HOME_SUBTITLE || '';
const heroPrimaryText: string = home.HOME_CTA_PRIMARY_TEXT || '';
const heroPrimaryLink: string = home.HOME_CTA_PRIMARY_LINK || '#';
const heroSecondaryText: string = home.HOME_CTA_SECONDARY_TEXT || '';
const heroSecondaryLink: string = home.HOME_CTA_SECONDARY_LINK || '#';

// Problem / Solution section
const psSectionTitle: string = home.PS_SECTION_TITLE || '';
const psSubtitle: string = home.PS_SUBTITLE || '';
const problemTag: string = home.PROBLEM_TAG || '';
const problemLabel: string = home.PROBLEM_LABEL || '';
const problemDescription: string = home.PROBLEM_DESCRIPTION || '';
const problemItems = [
  { title: home.PROBLEM_ITEM1_TITLE, sub: home.PROBLEM_ITEM1_SUB },
  { title: home.PROBLEM_ITEM2_TITLE, sub: home.PROBLEM_ITEM2_SUB },
  { title: home.PROBLEM_ITEM3_TITLE, sub: home.PROBLEM_ITEM3_SUB },
  { title: home.PROBLEM_ITEM4_TITLE, sub: home.PROBLEM_ITEM4_SUB }
];
const problemBottom: string = home.PROBLEM_BOTTOM || '';
const problemFooter: string = home.PROBLEM_FOOTER || '';

const solutionTag: string = home.SOLUTION_TAG || '';
const solutionLabel: string = home.SOLUTION_LABEL || '';
const solutionDescription: string = home.SOLUTION_DESCRIPTION || '';
const solutionItems = [
  { title: home.SOLUTION_ITEM1_TITLE, sub: home.SOLUTION_ITEM1_SUB },
  { title: home.SOLUTION_ITEM2_TITLE, sub: home.SOLUTION_ITEM2_SUB },
  { title: home.SOLUTION_ITEM3_TITLE, sub: home.SOLUTION_ITEM3_SUB },
  { title: home.SOLUTION_ITEM4_TITLE, sub: home.SOLUTION_ITEM4_SUB }
];
const solutionBottom: string = home.SOLUTION_BOTTOM || '';
const solutionFooter: string = home.SOLUTION_FOOTER || '';
const solutionCtaText: string = home.SOLUTION_CTA_TEXT || '';
const solutionCtaLink: string = home.SOLUTION_CTA_LINK || '#';

const trustIndicator1: string = home.TRUST_INDICATOR1_TEXT || '';
const trustIndicator2: string = home.TRUST_INDICATOR2_TEXT || '';

// Limited availability section
const limitedHeading: string = home.LIMITED_HEADING || '';
const limitedText: string = home.LIMITED_TEXT || '';
const limitedValue: number = parseFloat(home.LIMITED_PROGRESS_VALUE || '0');
const limitedLabel: string = home.LIMITED_PROGRESS_LABEL || '';

// How it works section
const howTitle: string = home.HOW_TITLE || '';
const howSubtitle: string = home.HOW_SUBTITLE || '';
const howSteps = [
  { number: 1, title: home.HOW_STEP1_TITLE, desc: home.HOW_STEP1_DESC },
  { number: 2, title: home.HOW_STEP2_TITLE, desc: home.HOW_STEP2_DESC },
  { number: 3, title: home.HOW_STEP3_TITLE, desc: home.HOW_STEP3_DESC },
  { number: 4, title: home.HOW_STEP4_TITLE, desc: home.HOW_STEP4_DESC },
  { number: 5, title: home.HOW_STEP5_TITLE, desc: home.HOW_STEP5_DESC }
];
const howExampleImage: string = home.HOW_EXAMPLE_IMAGE || '';
const howExampleCaption: string = home.HOW_EXAMPLE_CAPTION || '';
const howExampleNote: string = home.HOW_EXAMPLE_NOTE || '';

// Pricing section
const pricingTitle: string = home.PRICING_TITLE || '';
const pricingSubtitle: string = home.PRICING_SUBTITLE || '';
const basePrice: string = home.PRICING_BASE_PRICE || '';
const basePeriod: string = home.PRICING_BASE_PERIOD || '';
const baseFeatures = [
  home.PRICING_FEATURE1,
  home.PRICING_FEATURE2,
  home.PRICING_FEATURE3,
  home.PRICING_FEATURE4
].filter(Boolean);
const addOns = [
  { name: home.PRICING_ADDON1_NAME, price: home.PRICING_ADDON1_PRICE },
  { name: home.PRICING_ADDON2_NAME, price: home.PRICING_ADDON2_PRICE },
  { name: home.PRICING_ADDON3_NAME, price: home.PRICING_ADDON3_PRICE },
  { name: home.PRICING_ADDON4_NAME, price: home.PRICING_ADDON4_PRICE },
  { name: home.PRICING_ADDON5_NAME, price: home.PRICING_ADDON5_PRICE }
].filter(item => item.name && item.price);
const pricingNote: string = home.PRICING_NOTE || '';
const pricingCtaText: string = home.PRICING_CTA_TEXT || '';
const pricingCtaLink: string = home.PRICING_CTA_LINK || '#';

// CTA section
const ctaTitle: string = home.CTA_TITLE || '';
const ctaSubtitle: string = home.CTA_SUBTITLE || '';
const ctaButtonText: string = home.CTA_BUTTON_TEXT || '';
const ctaButtonLink: string = home.CTA_BUTTON_LINK || '#';

// Contact section
const contactTitle: string = home.CONTACT_TITLE || '';
const contactSubtitle: string = home.CONTACT_SUBTITLE || '';
const contactSuccessTitle: string = home.CONTACT_SUCCESS_TITLE || '';
const contactSuccessText: string = home.CONTACT_SUCCESS_TEXT || '';
const contactNameLabel: string = home.CONTACT_FIELD_NAME_LABEL || '';
const contactNamePlaceholder: string = home.CONTACT_FIELD_NAME_PLACEHOLDER || '';
const contactEmailLabel: string = home.CONTACT_FIELD_EMAIL_LABEL || '';
const contactEmailPlaceholder: string = home.CONTACT_FIELD_EMAIL_PLACEHOLDER || '';
const contactMessageLabel: string = home.CONTACT_FIELD_MESSAGE_LABEL || '';
const contactMessagePlaceholder: string = home.CONTACT_FIELD_MESSAGE_PLACEHOLDER || '';
const contactTerms: string = home.CONTACT_TERMS || '';
const contactSubmitText: string = home.CONTACT_SUBMIT_TEXT || '';

// Accessibility labels (aria-*).  These strings are stored in the database so
// that every visible aria-label can be translated per locale.  If a
// translation is missing the defaults below are used.
const ariaHeroSection: string = home.ARIA_HERO_SECTION || '';
const ariaHeroPreview: string = home.ARIA_HERO_PREVIEW || '';
const ariaGoToPricing: string = home.ARIA_GO_TO_PRICING || '';
const ariaGoToSetupAlerts: string = home.ARIA_GO_TO_SETUP_ALERTS || '';
const ariaSolutionCta: string = home.ARIA_SOLUTION_CTA || '';
const ariaTrustIndicators: string = home.ARIA_TRUST_INDICATORS || '';
const ariaHowSteps: string = home.ARIA_HOW_STEPS || '';
const ariaExampleTelegram: string = home.ARIA_EXAMPLE_TELEGRAM || '';
const ariaProblemCardPrefix: string = home.ARIA_PROBLEM_CARD_PREFIX || 'Problem:';
const ariaSolutionCardPrefix: string = home.ARIA_SOLUTION_CARD_PREFIX || 'Solution:';

---
<BaseLayout
  languageIso={languageIso}
  countryCode={countryCode}
  contentOrientation={contentOrientation}
  title={pageTitle}
  description={pageDescription}
  ogImage={pageOgImage}
  keywords={pageKeywords}
  schema={schema}
  languageLinksMap={languageLinksMap}
>
  <!-- Hero Section -->
  <section id="amiquus-hero" class="relative overflow-hidden py-20 sm:py-28 lg:py-32" aria-label={ariaHeroSection}>
    <div aria-hidden="true" class="absolute inset-0 -z-20 hero-bg"></div>
    <div id="hero-float-layer" aria-hidden="true" class="absolute inset-0 -z-10 pointer-events-none"></div>
    <div class="relative z-10 max-w-screen-xl mx-auto px-4">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">
        <!-- Left copy -->
        <div class="text-center lg:text-start animate-on-scroll">
          <h1 class="text-4xl md:text-5xl font-extrabold leading-tight text-foreground mb-5">
            {heroTitlePart1}
            <span class="text-primary">{heroHighlight}</span>
            {heroTitlePart2}
          </h1>
          <p class="text-base md:text-lg text-muted-foreground mb-8 max-w-xl mx-auto lg:mx-0">
            {heroSubtitle}
          </p>
          <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 justify-center lg:justify-start">
            <a href={heroPrimaryLink} class="inline-flex items-center justify-center px-6 py-3 rounded-lg font-semibold bg-primary text-primary-foreground shadow-lg hover:opacity-90 transition-transform hover:-translate-y-1" aria-label={ariaGoToPricing}>
              {heroPrimaryText}
            </a>
            <a href={heroSecondaryLink} class="inline-flex items-center justify-center px-6 py-3 rounded-lg font-semibold bg-transparent border border-border/70 text-foreground/90 hover:bg-white/5 transition-colors" aria-label={ariaGoToSetupAlerts}>
              {heroSecondaryText}
            </a>
          </div>
        </div>
        <!-- Right animation stage -->
        <div class="relative animate-on-scroll" data-delay="100" aria-label={ariaHeroPreview}>
          <div class="relative hero-stage h-[23.75rem] sm:h-[27.5rem] lg:h-[31.25rem] w-full">
            <div class="absolute inset-0 rounded-3xl hero-stage-panel overflow-hidden"></div>
            <div id="hero-main-wrap" class="absolute inset-0 grid place-items-center px-6 sm:px-8"></div>
            <div id="hero-final-overlay" class="hero-final-overlay" aria-hidden="true"></div>
            <div aria-hidden="true" class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-black/30 to-transparent dark:from-black/50"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Problem / Solution Section -->
  <section id="amiquus-probsol" class="relative py-14 sm:py-20 overflow-hidden bg-background" aria-labelledby="probsol-title">
    <div aria-hidden="true" class="probsol-fade probsol-fade--top"></div>
    <div aria-hidden="true" class="probsol-fade probsol-fade--bot"></div>
    <div aria-hidden="true" class="probsol-blob probsol-blob--red"></div>
    <div aria-hidden="true" class="probsol-blob probsol-blob--green"></div>
    <div class="max-w-screen-xl mx-auto px-4 relative z-10">
      <div class="text-center max-w-3xl mx-auto will-animate" data-anim="fade-up">
        <div class="uppercase tracking-[0.22em] text-xs md:text-sm text-muted-foreground/90 mb-3">
          Problem / Solution
        </div>
        <h2 id="probsol-title" class="text-3xl md:text-4xl lg:text-5xl font-extrabold tracking-tight text-foreground">
          {psSectionTitle.split('.')[0] || ''}.
          <span class="text-primary">{psSectionTitle.split('.')[1] || ''}</span>
        </h2>
        <p class="mt-3 text-base md:text-lg text-muted-foreground" aria-live="polite">
          {psSubtitle}
        </p>
      </div>
      <div class="mt-9 sm:mt-12 grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-8" role="list">
        <!-- Problem Card -->
        <article role="listitem" aria-label={`${ariaProblemCardPrefix} ${problemTag}`} class="group relative overflow-hidden rounded-2xl border border-border bg-muted/90 dark:bg-card/80 backdrop-blur-sm shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-xl will-animate" data-anim="fade-right">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 h-1.5 bg-gradient-to-r from-red-500 via-rose-500/95 to-red-500/40"></div>
          <header class="relative z-10 p-6 sm:p-7 flex items-start justify-between gap-4">
            <div class="inline-flex items-center gap-2 rounded-full px-3 py-1 text-xs font-extrabold tracking-wide bg-red-500/15 text-red-600 dark:text-red-400 border border-red-500/30">
              <span aria-hidden="true" class="h-2 w-2 rounded-full bg-red-500 animate-pulse"></span>
              {problemTag}
            </div>
            <div class="text-xs font-semibold text-muted-foreground">{problemLabel}</div>
          </header>
          <div class="relative z-10 px-6 sm:px-7 pb-6 sm:pb-7">
            <p class="text-base md:text-lg font-semibold text-foreground leading-relaxed">
              {problemDescription}
            </p>
            <div class="mt-5 grid grid-cols-1 sm:grid-cols-2 gap-3">
              {problemItems.map((item, index) => (
                <div class={`probsol-item probsol-item--p${index + 1}`}>
                  <div class="probsol-item-title">
                    <span class="amq-underline amq-underline--danger">{item.title}</span>
                  </div>
                  <div class="probsol-item-sub">{item.sub}</div>
                </div>
              ))}
            </div>
            <div class="mt-5 flex items-center justify-center gap-2 rounded-xl border border-red-500/30 bg-red-500/10 px-4 py-3 text-sm font-extrabold text-red-600 dark:text-red-400">
              <span class="inline-block h-2 w-2 rounded-full bg-red-500" aria-hidden="true"></span>
              {problemBottom}
            </div>
          </div>
          <footer class="relative z-10 px-6 sm:px-7 pb-6 sm:pb-7 text-sm text-muted-foreground font-semibold">
            {problemFooter}
          </footer>
        </article>
        <!-- Solution Card -->
        <article role="listitem" aria-label={`${ariaSolutionCardPrefix} ${solutionTag}`} class="group relative overflow-hidden rounded-2xl border border-border bg-muted/90 dark:bg-card/80 backdrop-blur-sm shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-xl will-animate" data-anim="fade-left">
          <div aria-hidden="true" class="absolute inset-x-0 top-0 h-1.5 bg-gradient-to-r from-emerald-500 via-teal-500/95 to-emerald-500/40"></div>
          <header class="relative z-10 p-6 sm:p-7 flex items-start justify-between gap-4">
            <div class="inline-flex items-center gap-2 rounded-full px-3 py-1 text-xs font-extrabold tracking-wide bg-emerald-500/15 text-emerald-700 dark:text-emerald-400 border border-emerald-500/30">
              <span aria-hidden="true" class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
              {solutionTag}
            </div>
            <div class="text-xs font-semibold text-muted-foreground">{solutionLabel}</div>
          </header>
          <div class="relative z-10 px-6 sm:px-7 pb-6 sm:pb-7">
            <p class="text-base md:text-lg font-semibold text-foreground leading-relaxed">
              {solutionDescription}
            </p>
            <div class="mt-5 grid grid-cols-1 sm:grid-cols-2 gap-3">
              {solutionItems.map((item, index) => (
                <div class={`probsol-item probsol-item--s${index + 1}`}>
                  <div class="probsol-item-title">
                    <span class="amq-underline amq-underline--success">{item.title}</span>
                  </div>
                  <div class="probsol-item-sub">{item.sub}</div>
                </div>
              ))}
            </div>
            <div class="mt-5 flex items-center justify-center gap-2 rounded-xl border border-emerald-500/30 bg-emerald-500/10 px-4 py-3 text-sm font-extrabold text-emerald-700 dark:text-emerald-400">
              <span class="inline-block h-2 w-2 rounded-full bg-emerald-500" aria-hidden="true"></span>
              {solutionBottom}
            </div>
          </div>
          <footer class="relative z-10 px-6 sm:px-7 pb-6 sm:pb-7 flex items-center justify-between gap-4">
            <div class="text-sm text-muted-foreground font-semibold">
              {solutionFooter}
            </div>
            <a href={solutionCtaLink} aria-label={ariaSolutionCta} class="cta-pulse inline-flex items-center gap-2 rounded-full px-4 py-2 text-sm font-extrabold bg-emerald-600 text-white shadow-md hover:opacity-95 hover:-translate-y-0.5 transition">
              {solutionCtaText}
              <svg viewBox="0 0 24 24" class="h-4 w-4" aria-hidden="true">
                <path fill="currentColor" d="M13 5l7 7-7 7v-4H4v-6h9V5z" />
              </svg>
            </a>
          </footer>
        </article>
      </div>
      <div class="mt-7 sm:mt-8 flex flex-col sm:flex-row items-center justify-center gap-4 will-animate" data-anim="fade-up" aria-label={ariaTrustIndicators}>
        <div class="flex items-center gap-2 text-xs md:text-sm text-muted-foreground">
          <span class="i-badge" aria-hidden="true"></span>
          <span>{trustIndicator1}</span>
        </div>
        <div class="hidden sm:block h-4 w-px bg-border/40" aria-hidden="true"></div>
        <div class="flex items-center gap-2 text-xs md:text-sm text-muted-foreground">
          <span class="i-shield" aria-hidden="true"></span>
          <span>{trustIndicator2}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Limited Availability Section -->
  <section class="py-12 bg-card border-y border-border">
    <div class="max-w-screen-xl mx-auto px-4">
      <div class="max-w-2xl mx-auto bg-gradient-to-br from-destructive/15 to-primary/20 border-2 border-destructive rounded-xl p-8 text-center animate-on-scroll">
        <h3 class="text-2xl font-bold text-destructive mb-4">
          {limitedHeading}
        </h3>
        <p class="text-foreground mb-4">

---
// src/pages/si/index.astro

import BaseLayout from '../../layouts/BaseLayout.astro';

// Page-specific metadata
const title = "Amiquus - Automated Car Listing Alerts";
const description = "Get real-time notifications for new car listings that match your criteria. Monitor multiple platforms automatically with instant Telegram alerts.";

// Props for BaseLayout - simplified to match working pattern
const languageIso = "en";
const countryCode = "US";
const contentOrientation = "ltr";
const languageLinksMap = { 'en': '/en', 'de': '/de' };
---

<BaseLayout
  languageIso={languageIso}
  countryCode={countryCode}
  contentOrientation={contentOrientation}
  title={title}
  description={description}
  languageLinksMap={languageLinksMap}
>
  <!-- Hero Section -->
  <section
    id="amiquus-hero"
    class="relative overflow-hidden py-20 sm:py-28 lg:py-32"
    aria-label="Amiquus hero section"
  >
    <!-- gradient background -->
    <div aria-hidden="true" class="absolute inset-0 -z-20 hero-bg"></div>

    <!-- hero-wide floating background layer -->
    <div
      id="hero-float-layer"
      aria-hidden="true"
      class="absolute inset-0 -z-10 pointer-events-none"
    ></div>

    <div class="relative z-10 max-w-screen-xl mx-auto px-4">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">
        <!-- Left copy -->
        <div class="text-center lg:text-start animate-on-scroll">
          <h1 class="text-4xl md:text-5xl font-extrabold leading-tight text-foreground mb-5">
            Never Miss Your
            <span class="text-primary">Perfect Car Deal</span>
            Again
          </h1>

          <p class="text-base md:text-lg text-muted-foreground mb-8 max-w-xl mx-auto lg:mx-0">
            Amiquus monitors multiple car listing platforms 24/7 and sends instant Telegram notifications the moment a matching car appears — so you act first, not last.
          </p>

          <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 justify-center lg:justify-start">
            <a
              href="#pricing"
              class="inline-flex items-center justify-center px-6 py-3 rounded-lg font-semibold bg-primary text-primary-foreground shadow-lg hover:opacity-90 transition-transform hover:-translate-y-1"
              aria-label="Go to pricing"
            >
              Pricing
            </a>
            <a
              href="/si/setup-alerts"
              class="inline-flex items-center justify-center px-6 py-3 rounded-lg font-semibold bg-transparent border border-border/70 text-foreground/90 hover:bg-white/5 transition-colors"
              aria-label="Go to setup alerts"
            >
              Get Alerts
            </a>
          </div>
        </div>

        <!-- Right animation stage -->
        <div class="relative animate-on-scroll" data-delay="100" aria-label="Animated missed opportunities preview">
          <div class="relative hero-stage h-[23.75rem] sm:h-[27.5rem] lg:h-[31.25rem] w-full">
            <!-- Stage panel (no ugly frame) -->
            <div class="absolute inset-0 rounded-3xl hero-stage-panel overflow-hidden"></div>

            <!-- Foreground main card -->
            <div id="hero-main-wrap" class="absolute inset-0 grid place-items-center px-6 sm:px-8">
              <!-- injected by script -->
            </div>

            <!-- Final text overlay (after 6 cards) -->
            <div id="hero-final-overlay" class="hero-final-overlay" aria-hidden="true"></div>

            <!-- subtle depth fade at bottom -->
            <div aria-hidden="true" class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-black/30 to-transparent dark:from-black/50"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- "PROBLEM / SOLUTION" SECTION (V4 — smoother transitions, cleaner blocks, wobble, Telegram callout, CTA pulse) -->
  <section
    id="amiquus-probsol"
    class="relative py-14 sm:py-20 overflow-hidden bg-background"
    aria-labelledby="probsol-title"
  >
    <!-- soft transition fades so section blends with neighbors -->
    <div aria-hidden="true" class="probsol-fade probsol-fade--top"></div>
    <div aria-hidden="true" class="probsol-fade probsol-fade--bot"></div>

    <!-- soft blobs / brand-colored, very subtle -->
    <div aria-hidden="true" class="probsol-blob probsol-blob--red"></div>
    <div aria-hidden="true" class="probsol-blob probsol-blob--green"></div>

    <div class="max-w-screen-xl mx-auto px-4 relative z-10">
      <div class="text-center max-w-3xl mx-auto will-animate" data-anim="fade-up">
        <div class="uppercase tracking-[0.22em] text-xs md:text-sm text-muted-foreground/90 mb-3">
          Problem / Solution
        </div>

        <h2 id="probsol-title" class="text-3xl md:text-4xl lg:text-5xl font-extrabold tracking-tight text-foreground">
          Stop reacting.
          <span class="text-primary">Start winning deals.</span>
        </h2>

        <p class="mt-3 text-base md:text-lg text-muted-foreground" aria-live="polite">
          Two paths. One keeps you chasing. The other puts you first.
        </p>
      </div>

      <div class="mt-9 sm:mt-12 grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-8" role="list">
        <!-- PROBLEM CARD -->
        <article
          role="listitem"
          aria-label="Problem: manual refreshing"
          class="group relative overflow-hidden rounded-2xl border border-border bg-muted/90 dark:bg-card/80 backdrop-blur-sm shadow-sm
                transition-all duration-300 hover:-translate-y-1 hover:shadow-xl will-animate"
          data-anim="fade-right"
        >
          <!-- top accent -->
          <div aria-hidden="true" class="absolute inset-x-0 top-0 h-1.5 bg-gradient-to-r from-red-500 via-rose-500/95 to-red-500/40"></div>

          <header class="relative z-10 p-6 sm:p-7 flex items-start justify-between gap-4">
            <div class="inline-flex items-center gap-2 rounded-full px-3 py-1 text-xs font-extrabold tracking-wide
                        bg-red-500/15 text-red-600 dark:text-red-400 border border-red-500/30">
              <span aria-hidden="true" class="h-2 w-2 rounded-full bg-red-500 animate-pulse"></span>
              Manual refreshing
            </div>
            <div class="text-xs font-semibold text-muted-foreground">The old way</div>
          </header>

          <div class="relative z-10 px-6 sm:px-7 pb-6 sm:pb-7">
            <p class="text-base md:text-lg font-semibold text-foreground leading-relaxed">
              You keep reloading listings and scrolling noise, but the best cars disappear before you even notice them.
            </p>

            <!-- neutral wobbling blocks -->
            <div class="mt-5 grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div class="probsol-item probsol-item--p1">
                <div class="probsol-item-title">
                  <span class="amq-underline amq-underline--danger">Time sink</span>
                </div>
                <div class="probsol-item-sub">Hours lost scanning junk</div>
              </div>

              <div class="probsol-item probsol-item--p2">
                <div class="probsol-item-title">
                  <span class="amq-underline amq-underline--danger">Missed deals</span>
                </div>
                <div class="probsol-item-sub">Top listings vanish fast</div>
              </div>

              <div class="probsol-item probsol-item--p3">
                <div class="probsol-item-title">
                  <span class="amq-underline amq-underline--danger">Stress mode</span>
                </div>
                <div class="probsol-item-sub">Always chasing the feed</div>
              </div>

              <div class="probsol-item probsol-item--p4">
                <div class="probsol-item-title">
                  <span class="amq-underline amq-underline--danger">Lost profit</span>
                </div>
                <div class="probsol-item-sub">You’re late to call</div>
              </div>
            </div>

            <div class="mt-5 flex items-center justify-center gap-2 rounded-xl border border-red-500/30 bg-red-500/10 px-4 py-3 text-sm font-extrabold text-red-600 dark:text-red-400">
              <span class="inline-block h-2 w-2 rounded-full bg-red-500" aria-hidden="true"></span>
              Slow reactions → someone else buys first
            </div>
          </div>

          <footer class="relative z-10 px-6 sm:px-7 pb-6 sm:pb-7 text-sm text-muted-foreground font-semibold">
            Reactive by default. You see it after others already moved.
          </footer>
        </article>

        <!-- SOLUTION CARD -->
        <article
          role="listitem"
          aria-label="Solution: Amiquus automated alerts"
          class="group relative overflow-hidden rounded-2xl border border-border bg-muted/90 dark:bg-card/80 backdrop-blur-sm shadow-sm
                transition-all duration-300 hover:-translate-y-1 hover:shadow-xl will-animate"
          data-anim="fade-left"
        >
          <!-- top accent -->
          <div aria-hidden="true" class="absolute inset-x-0 top-0 h-1.5 bg-gradient-to-r from-emerald-500 via-teal-500/95 to-emerald-500/40"></div>

          <header class="relative z-10 p-6 sm:p-7 flex items-start justify-between gap-4">
            <div class="inline-flex items-center gap-2 rounded-full px-3 py-1 text-xs font-extrabold tracking-wide
                        bg-emerald-500/15 text-emerald-700 dark:text-emerald-400 border border-emerald-500/30">
              <span aria-hidden="true" class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
              Automated alerts
            </div>
            <div class="text-xs font-semibold text-muted-foreground">The Amiquus way</div>
          </header>

          <div class="relative z-10 px-6 sm:px-7 pb-6 sm:pb-7">
            <p class="text-base md:text-lg font-semibold text-foreground leading-relaxed">
              Amiquus scans 24/7 and pings you on Telegram within seconds — so you contact sellers first.
            </p>

            <!-- neutral wobbling blocks -->
            <div class="mt-5 grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div class="probsol-item probsol-item--s1">
                <div class="probsol-item-title">
                  <span class="amq-underline amq-underline--success">24/7 scan</span>
                </div>
                <div class="probsol-item-sub">Zero downtime monitoring</div>
              </div>

              <div class="probsol-item probsol-item--s2">
                <div class="probsol-item-title">
                  <span class="amq-underline amq-underline--success">Telegram pings</span>
                </div>
                <div class="probsol-item-sub">Photos, price, contact — instantly</div>
              </div>

              <div class="probsol-item probsol-item--s3">
                <div class="probsol-item-title">
                  <span class="amq-underline amq-underline--success">Full coverage</span>
                </div>
                <div class="probsol-item-sub">Multiple sites, one feed</div>
              </div>

              <div class="probsol-item probsol-item--s4">
                <div class="probsol-item-title">
                  <span class="amq-underline amq-underline--success">First-mover edge</span>
                </div>
                <div class="probsol-item-sub">You call before others</div>
              </div>
            </div>

            <div class="mt-5 flex items-center justify-center gap-2 rounded-xl border border-emerald-500/30 bg-emerald-500/10 px-4 py-3 text-sm font-extrabold text-emerald-700 dark:text-emerald-400">
              <span class="inline-block h-2 w-2 rounded-full bg-emerald-500" aria-hidden="true"></span>
              Instant reaction → profit stays with you
            </div>
          </div>

          <footer class="relative z-10 px-6 sm:px-7 pb-6 sm:pb-7 flex items-center justify-between gap-4">
            <div class="text-sm text-muted-foreground font-semibold">
              Proactive by design. You see it first.
            </div>

            <a
              href="/si/setup-alerts"
              aria-label="Start automated alerts"
              class="cta-pulse inline-flex items-center gap-2 rounded-full px-4 py-2 text-sm font-extrabold
                     bg-emerald-600 text-white shadow-md hover:opacity-95 hover:-translate-y-0.5 transition"
            >
              Start alerts
              <svg viewBox="0 0 24 24" class="h-4 w-4" aria-hidden="true">
                <path fill="currentColor" d="M13 5l7 7-7 7v-4H4v-6h9V5z"/>
              </svg>
            </a>
          </footer>
        </article>
      </div>

      <div class="mt-7 sm:mt-8 flex flex-col sm:flex-row items-center justify-center gap-4 will-animate" data-anim="fade-up" aria-label="Trust indicators">
        <div class="flex items-center gap-2 text-xs md:text-sm text-muted-foreground">
          <span class="i-badge" aria-hidden="true"></span>
          <span>Checks listings every ~15s on supported sites</span>
        </div>
        <div class="hidden sm:block h-4 w-px bg-border/40" aria-hidden="true"></div>
        <div class="flex items-center gap-2 text-xs md:text-sm text-muted-foreground">
          <span class="i-shield" aria-hidden="true"></span>
          <span>No spam. Cancel anytime.</span>
        </div>
      </div>
    </div>
  </section>

  <!-- IMPORTANT: is:global so injected hero cards receive styles -->
  <style is:global>
    /* =========================================================
       HERO + PROBSOL are global, theme-safe, and token-based
       ========================================================= */

    /* ---------- HERO THEME ---------- */
    #amiquus-hero {
      position: relative;

      /* no rounded bottom edges */
      border-bottom-left-radius: 0;
      border-bottom-right-radius: 0;
      overflow: hidden;

      --destructive: 0 84% 55%;

      /* Light mode should match other bg-background sections */
      --hero-bg-a: var(--background);
      --hero-bg-b: var(--background);
      --hero-bg-c: var(--background);

      --hero-stage-glass: rgba(255, 255, 255, 0.8);
      --hero-stage-glass-2: rgba(255, 255, 255, 0.58);
      --hero-stage-border: rgba(0, 0, 0, 0.06);

      --hero-card-glass: rgba(255, 255, 255, 0.94);
      --hero-card-glass-2: rgba(255, 255, 255, 0.78);
      --hero-card-border: rgba(0, 0, 0, 0.1);

      --hero-float-opacity: 0.34;
      --hero-float-blur: 0.4375rem; /* 7px */

      --money-red: 0 84% 55%;
    }

    .dark #amiquus-hero {
      --destructive: 0 84% 55%;

      --hero-bg-a: 225 85% 14%;
      --hero-bg-b: 160 70% 12%;
      --hero-bg-c: 230 55% 8%;

      --hero-stage-glass: rgba(8, 12, 22, 0.72);
      --hero-stage-glass-2: rgba(8, 12, 22, 0.48);
      --hero-stage-border: rgba(255, 255, 255, 0.14);

      --hero-card-glass: rgba(10, 14, 25, 0.84);
      --hero-card-glass-2: rgba(10, 14, 25, 0.62);
      --hero-card-border: rgba(255, 255, 255, 0.16);

      --hero-float-opacity: 0.3;
      --hero-float-blur: 0.625rem; /* 10px */

      --money-red: 0 84% 55%;
    }

    /* Light mode hero background: FLAT like other sections */
    #amiquus-hero .hero-bg {
      background: rgb(var(--background));
    }
    /* Dark mode hero background: moody gradient */
    .dark #amiquus-hero .hero-bg {
      background:
        radial-gradient(70rem 38rem at 0% -10%, hsl(var(--hero-bg-a)) 0%, transparent 60%),
        radial-gradient(60rem 30rem at 95% 10%, hsl(var(--hero-bg-b)) 0%, transparent 60%),
        linear-gradient(180deg, hsl(var(--hero-bg-c)) 0%, transparent 70%);
    }

    /* soften hero bottom so no hard “frame” edge */
    #amiquus-hero::after {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      bottom: -1px;
      height: 8.75rem; /* 140px */
      pointer-events: none;
      z-index: 2;
      background: linear-gradient(to bottom, transparent 0%, transparent 100%);
    }
    .dark #amiquus-hero::after {
      background:
        linear-gradient(
          to bottom,
          transparent 0%,
          rgb(var(--background) / 0.55) 55%,
          rgb(var(--background)) 100%
        );
    }

    .hero-stage {
      filter: drop-shadow(0 1.875rem 4.375rem rgb(0 0 0 / 0.22)); /* 30px 70px */
      perspective: 56.25rem; /* 900px */

      border-radius: 1.5rem;
      overflow: hidden;
      isolation: isolate;
    }
    .dark .hero-stage {
      filter: drop-shadow(0 1.875rem 4.375rem rgb(0 0 0 / 0.5));
    }

    .hero-stage-panel {
      background:
        radial-gradient(120% 100% at 20% 0%, var(--hero-stage-glass) 0%, transparent 55%),
        linear-gradient(180deg, var(--hero-stage-glass), var(--hero-stage-glass-2));
      border: 0.0625rem solid var(--hero-stage-border);
      backdrop-filter: blur(0.875rem) saturate(1.1); /* 14px */
      box-shadow:
        inset 0 0 0 0.0625rem rgba(255, 255, 255, 0.2),
        inset 0 -1.875rem 3.75rem rgba(0, 0, 0, 0.04),
        0 1.375rem 4.375rem rgb(0 0 0 / 0.1); /* 22px 70px */
    }
    .dark .hero-stage-panel {
      box-shadow:
        inset 0 0 0 0.0625rem rgba(255, 255, 255, 0.1),
        inset 0 -1.875rem 3.75rem rgba(0, 0, 0, 0.3),
        0 1.5625rem 5rem rgb(0 0 0 / 0.45); /* 25px 80px */
    }

    /* ---------- HERO CARDS ---------- */
    .hero-float-card,
    .hero-main-card {
      position: absolute;
      border-radius: 1.25rem;
      overflow: hidden;
      border: 0.0625rem solid var(--hero-card-border);
      box-shadow:
        0 1.125rem 2.8125rem rgb(0 0 0 / 0.18), /* 18px 45px */
        inset 0 0 0 0.0625rem rgba(255 255 255 / 0.08);
      backdrop-filter: blur(0.75rem) saturate(1.15); /* 12px */
      -webkit-backdrop-filter: blur(0.75rem) saturate(1.15);

      background:
        radial-gradient(140% 120% at 0% 0%, var(--hero-card-glass) 0%, transparent 55%),
        linear-gradient(180deg, var(--hero-card-glass), var(--hero-card-glass-2));

      will-change: transform, opacity, filter;
      transform-style: preserve-3d;
      pointer-events: none;
    }

    .hero-float-card {
      width: clamp(11.875rem, 20vw, 18.75rem); /* 190px–300px */
      opacity: var(--hero-float-opacity);
      filter: blur(var(--hero-float-blur)) saturate(0.98);
    }

    .hero-main-card {
      position: relative;
      width: min(92%, 26.25rem); /* 420px */
      animation: mainWiggle 1.3s ease-in-out infinite;
      pointer-events: auto;
    }

    @keyframes mainWiggle {
      0%,
      100% {
        transform: translateY(0) rotate(-0.6deg);
      }
      50% {
        transform: translateY(-0.1875rem) rotate(0.6deg); /* 3px */
      }
    }

    .hero-card-img {
      height: 13rem; /* ~208px */
      background: rgb(var(--muted));
      display: grid;
      place-items: center;
      position: relative;
      border-top-left-radius: inherit;
      border-top-right-radius: inherit;
      overflow: hidden;
      z-index: 0;
    }

    .hero-card-img img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      position: relative;
      z-index: 1;
    }

    .hero-float-card .hero-card-img {
      height: 11rem; /* ~176px */
    }
    .hero-float-card .hero-meta {
      padding: 0.75rem 0.9rem;
    }

    .hero-meta {
      padding: 0.9rem 1rem;
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 0.5rem 0.75rem;
      align-items: center;
      background: linear-gradient(180deg, rgba(255, 255, 255, 0.45), transparent);
      border-bottom-left-radius: inherit;
      border-bottom-right-radius: inherit;
    }
    .dark .hero-meta {
      background: linear-gradient(180deg, rgba(255, 255, 255, 0.04), transparent);
    }

    .hero-brand {
      font-weight: 900;
      font-size: 1.05rem;
      color: rgb(var(--primary));
      line-height: 1.15;
      text-shadow: 0 0.125rem 0 rgb(0 0 0 / 0.06); /* 2px */
    }

    .hero-model {
      font-weight: 700;
      font-size: 0.98rem;
      color: rgb(var(--foreground));
      opacity: 0.95;
    }

    .hero-price {
      font-weight: 900;
      font-size: 1.18rem;
      color: hsl(142 76% 36%);

      white-space: nowrap;
      text-shadow:
        0 0.375rem 1.125rem rgb(0 0 0 / 0.1), /* 6px 18px */
        0 0 1.125rem hsl(142 76% 36% / 0.4); /* 18px */
      letter-spacing: 0.0125rem;
    }
    .dark .hero-price {
      text-shadow:
        0 0.375rem 1.125rem rgb(0 0 0 / 0.25),
        0 0 1.125rem hsl(142 76% 36% / 0.7);
    }

    .hero-sub {
      font-size: 0.8rem;
      color: rgb(var(--muted-foreground));
      margin-top: 0.1rem;
    }

    /* ---------- STAMP ---------- */
    .hero-stamp {
      position: absolute;
      top: 0.875rem; /* 14px */
      left: 50%;
      padding: 0.48rem 1.05rem;
      border-radius: 9999px;
      font-weight: 950;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: #fff;
      font-size: 0.7rem;
      line-height: 1.1;
      text-align: center;

      /* Solid red-ish pill, no stripes */
      background:
        radial-gradient(120% 140% at 100% 0%, rgb(255 255 255 / 0.16), transparent 60%),
        linear-gradient(
          180deg,
          hsl(var(--destructive)) 0%,
          hsl(var(--destructive) / 0.9) 100%
        );

      border: 0.125rem solid rgb(255 255 255 / 0.95);
      box-shadow:
        0 0.5rem 1.375rem rgb(0 0 0 / 0.45), /* 8px 22px */
        inset 0 0 0 0.0625rem rgb(255 255 255 / 0.18),
        inset 0 -0.375rem 0.75rem rgb(0 0 0 / 0.18);

      transform: translateX(-50%) rotate(-9deg) scale(0.94);
      opacity: 0;
      filter: blur(0.0125rem) contrast(1.15);
      pointer-events: none;
      z-index: 50;

      text-shadow:
        0 0.125rem 0 rgb(0 0 0 / 0.55),
        0 0 0.625rem rgb(0 0 0 / 0.25);
      white-space: normal; /* allow two lines */
    }

    .hero-stamp::after {
      content: "";
      position: absolute;
      inset: -0.1875rem; /* 3px */
      border-radius: inherit;
      border: 0.0625rem dashed rgb(255 255 255 / 0.55);
      opacity: 0.55;
      pointer-events: none;
      mix-blend-mode: overlay;
    }

    .hero-main-card.is-stamping .hero-stamp {
      animation: stampIn 0.6s cubic-bezier(0.2, 0.9, 0.25, 1.2) forwards;
    }

    @keyframes stampIn {
      0% {
        opacity: 0;
        transform: translateX(-50%) rotate(-18deg) scale(0.25);
      }
      70% {
        opacity: 1;
        transform: translateX(-50%) rotate(-9deg) scale(1.12);
      }
      100% {
        opacity: 1;
        transform: translateX(-50%) rotate(-9deg) scale(1);
        filter: none;
      }
    }

    .hero-main-card.is-entering {
      opacity: 0;
      transform: translateY(0.875rem) scale(0.985); /* 14px */
      filter: blur(0.0625rem); /* 1px */
    }

    .hero-main-card.is-ashing {
      opacity: 0;
      transform: translateY(3.75rem) scale(0.9) rotateX(12deg); /* 60px */
      filter: blur(0.375rem) grayscale(1); /* 6px */
      transition: transform 0.9s ease, opacity 0.9s ease, filter 0.9s ease;
      pointer-events: none;
    }

    .ash {
      position: absolute;
      left: 8%;
      right: 8%;
      bottom: 0.625rem; /* 10px */
      height: 1.125rem; /* 18px */
      background: radial-gradient(closest-side, rgb(255 255 255 / 0.22), transparent 70%);
      filter: blur(0.5rem); /* 8px */
      opacity: 0;
      animation: ashPoof 0.95s ease forwards;
    }
    @keyframes ashPoof {
      0% {
        opacity: 0;
        transform: scale(0.6) translateY(0);
      }
      25% {
        opacity: 0.7;
        transform: scale(1) translateY(-0.125rem); /* 2px */
      }
      100% {
        opacity: 0;
        transform: scale(1.5) translateY(0.375rem); /* 6px */
      }
    }

    /* ---------- MONEY LOSS ---------- */
    .money-puff {
      position: absolute;
      transform: translate(-50%, -50%);
      font-weight: 1000;

      color: hsl(var(--money-red));
      text-shadow:
        0 0.625rem 1.75rem rgb(0 0 0 / 0.55), /* 10px 28px */
        0 0 1.375rem hsl(var(--money-red) / 0.9); /* 22px */

      pointer-events: none;
      opacity: 0;
      animation: moneyPuff 3.2s ease forwards;
      will-change: transform, opacity, filter;
    }

    @keyframes moneyPuff {
      0% {
        opacity: 0;
        transform: translate(-50%, -50%) scale(0.55) rotate(var(--rot));
        filter: blur(0);
      }
      8% {
        opacity: 1;
        transform: translate(-50%, -90%) scale(1.35) rotate(var(--rot));
      }

      60% {
        opacity: 1;
        transform: translate(
            calc(-50% + var(--dx) * 0.6),
            calc(-50% - 10.9375rem)
          ) /* 175px */
          scale(1.12)
          rotate(calc(var(--rot) * 1.25));
      }

      100% {
        opacity: 0;
        transform:
          translate(
            calc(-50% + var(--dx)),
            calc(-50% - 17.5rem)
          ) /* 280px */
          scale(0.18)
          rotate(calc(var(--rot) * 1.7));
        filter: blur(0.5rem) saturate(0.55); /* 8px */
      }
    }

    /* ---------- FINAL OVERLAY ---------- */
    .hero-final-overlay {
      position: absolute;
      inset: 0;
      display: grid;
      place-items: center;
      text-align: center;
      font-weight: 900;
      letter-spacing: 0.0375rem;

      background:
        radial-gradient(90% 80% at 50% 50%, rgb(0 0 0 / 0.1), rgb(0 0 0 / 0.52)),
        linear-gradient(180deg, hsl(var(--destructive) / 0.1), transparent);

      opacity: 0;
      transform: scale(0.98);
      pointer-events: none;
      backdrop-filter: blur(0.375rem); /* 6px */

      border-radius: 1.5rem;
    }

    .hero-final-overlay .glass {
      padding: clamp(1.15rem, 2vw, 1.75rem)
        clamp(1.3rem, 3vw, 2.4rem);
      border-radius: 1.35rem;

      background: linear-gradient(
        180deg,
        rgb(255 255 255 / 0.2),
        rgb(255 255 255 / 0.08)
      );
      border: 0.0625rem solid rgb(255 255 255 / 0.45);
      box-shadow:
        0 1.125rem 3.75rem rgb(0 0 0 / 0.45), /* 18px 60px */
        inset 0 0 0 0.0625rem rgb(255 255 255 / 0.12);
    }

    .hero-final-overlay.show {
      animation: finalOverlay 3s ease forwards;
    }

    .hero-final-overlay .line1 {
      font-size: clamp(1.9rem, 4vw, 2.85rem);
      text-transform: uppercase;
      color: rgb(var(--foreground));
      text-shadow: 0 0.625rem 1.875rem rgb(0 0 0 / 0.65); /* 10px 30px */
    }
    .hero-final-overlay .line1 span {
      color: inherit;
      text-shadow: inherit;
    }

    .hero-final-overlay .line2 {
      margin-top: 0.55rem;
      font-size: clamp(1.4rem, 3.1vw, 2.2rem);
      color: hsl(var(--money-red));
      text-transform: uppercase;
      letter-spacing: 0.12em;
      text-shadow:
        0 0.625rem 1.875rem rgb(0 0 0 / 0.65),
        0 0 1.625rem hsl(var(--money-red) / 0.85); /* 26px */
    }
    .hero-final-overlay .line2 span {
      color: inherit;
      text-shadow: inherit;
    }

    @keyframes finalOverlay {
      0% {
        opacity: 0;
        transform: scale(0.98);
      }
      12% {
        opacity: 1;
        transform: scale(1);
      }
      88% {
        opacity: 1;
        transform: scale(1);
      }
      100% {
        opacity: 0;
        transform: scale(1.02);
      }
    }

    /* =========================================================
       PROBLEM / SOLUTION — V4
       ========================================================= */
    #amiquus-probsol {
      position: relative;
      isolation: isolate;
    }

    /* blending fades (now using rgb tokens, no weird tint) */
    .probsol-fade {
      position: absolute;
      left: -10%;
      right: -10%;
      height: 7.5rem; /* 120px */
      z-index: 1;
      pointer-events: none;
      background: linear-gradient(
        to bottom,
        rgb(var(--background)) 0%,
        transparent 100%
      );
    }
    .probsol-fade--top {
      top: -1px;
      transform: translateY(-40%);
    }
    .probsol-fade--bot {
      bottom: -1px;
      transform: translateY(40%) rotate(180deg);
    }
    .dark .probsol-fade {
      background: linear-gradient(
        to bottom,
        rgb(var(--background)) 0%,
        transparent 100%
      );
      opacity: 0.9;
    }

    .probsol-blob {
      position: absolute;
      width: 32.5rem; /* 520px */
      height: 32.5rem;
      border-radius: 9999px;
      filter: blur(5rem); /* 80px */
      opacity: 0.28;
      z-index: 0;
      pointer-events: none;
      animation: blobFloat 18s ease-in-out infinite;
      transform: translate3d(0, 0, 0);
    }
    .probsol-blob--red {
      left: -11.25rem; /* 180px */
      top: -13.75rem; /* 220px */
      background: radial-gradient(
        circle,
        rgb(var(--amq-danger)) / 0.9,
        transparent 60%
      );
      animation-delay: -4s;
    }
    .probsol-blob--green {
      right: -11.25rem;
      bottom: -15rem; /* 240px */
      background: radial-gradient(
        circle,
        rgb(var(--amq-success)) / 0.9,
        transparent 60%
      );
      animation-delay: -9s;
    }
    .dark .probsol-blob {
      opacity: 0.4;
      filter: blur(5.9375rem); /* 95px */
    }
    @keyframes blobFloat {
      0%,
      100% {
        transform: translateY(0) translateX(0) scale(1);
      }
      50% {
        transform: translateY(1.5625rem) translateX(0.9375rem) scale(1.05); /* 25px 15px */
      }
    }

    /* clean blocks — neutral backgrounds */
    .probsol-item {
      position: relative;
      display: grid;
      gap: 0.25rem;
      padding: 1rem 1.05rem;
      border-radius: 0.95rem;
      border: 0.0625rem solid rgb(var(--border) / 0.9);
      background: rgb(var(--card));
      box-shadow: inset 0 0.0625rem 0 rgb(255 255 255 / 0.35);
      backdrop-filter: blur(0.375rem); /* 6px */
      will-change: transform;
      animation: probsolWobble 5.5s ease-in-out infinite;
    }
    .dark .probsol-item {
      background: rgb(var(--card) / 0.9);
      box-shadow: inset 0 0.0625rem 0 rgb(255 255 255 / 0.06);
      border-color: rgb(var(--border) / 0.7);
    }

    .probsol-item-title {
      font-weight: 900;
      color: rgb(var(--foreground));
      font-size: 1rem;
      letter-spacing: 0.0125rem;
    }
    .probsol-item-sub {
      font-size: 0.88rem;
      color: rgb(var(--muted-foreground));
      font-weight: 600;
      line-height: 1.35;
    }

    /* staggered wobble only; keep neutral colors */
    .probsol-item--p1 {
      animation-delay: -0.5s;
    }
    .probsol-item--p2 {
      animation-delay: -1.3s;
    }
    .probsol-item--p3 {
      animation-delay: -2.1s;
    }
    .probsol-item--p4 {
      animation-delay: -2.9s;
    }

    .probsol-item--s1 {
      animation-delay: -0.7s;
    }
    .probsol-item--s2 {
      animation-delay: -1.6s;
    }
    .probsol-item--s3 {
      animation-delay: -2.4s;
    }
    .probsol-item--s4 {
      animation-delay: -3.2s;
    }

    @keyframes probsolWobble {
      0%,
      100% {
        transform: translateY(0) translateX(0) rotate(0deg);
      }
      25% {
        transform: translateY(-0.125rem) translateX(0.0625rem) rotate(0.2deg); /* 2px 1px */
      }
      50% {
        transform: translateY(0.0625rem) translateX(-0.0625rem) rotate(-0.2deg); /* 1px */
      }
      75% {
        transform: translateY(-0.0625rem) translateX(0.03125rem) rotate(0.15deg); /* 1px ~ */
      }
    }

    /* CTA pulse */
    .cta-pulse {
      position: relative;
      animation: ctaPulse 2.2s ease-in-out infinite;
      box-shadow: 0 0.625rem 1.875rem hsl(142 76% 36% / 0.35); /* 10px 30px */
    }
    @keyframes ctaPulse {
      0%,
      100% {
        transform: translateY(0);
        box-shadow:
          0 0.625rem 1.875rem hsl(142 76% 36% / 0.35),
          0 0 0 0 hsl(142 76% 36% / 0.35);
      }
      50% {
        transform: translateY(-0.0625rem); /* 1px */
        box-shadow:
          0 0.875rem 2.125rem hsl(142 76% 36% / 0.5),
          0 0 0 0.625rem hsl(142 76% 36% / 0); /* 10px */
      }
    }

    .will-animate {
      opacity: 0;
      transform: translateY(0.75rem); /* 12px */
      transition: opacity 0.6s ease, transform 0.6s ease;
    }
    .will-animate.in-view {
      opacity: 1;
      transform: none;
    }

    /* =========================================================
       ANIMATED UNDERLINE (darker, thicker, per-section animated)
       ========================================================= */

    .amq-underline {
      position: relative;
      display: inline-block;
      padding-bottom: 0.04em;
      background-image: linear-gradient(
        to top,
        hsl(var(--primary)) 0,
        hsl(var(--primary)) 0.28em,
        transparent 0.28em
      );
      background-repeat: no-repeat;
      background-size: 100% 0.28em; /* default: fully underlined, a bit thicker/darker */
      background-position: 0 100%;
    }

    .dark .amq-underline {
      background-image: linear-gradient(
        to top,
        hsl(var(--primary)) 0,
        hsl(var(--primary)) 0.28em,
        transparent 0.28em
      );
    }

    /* variants with stronger accent colors */
    .amq-underline--danger {
      background-image: linear-gradient(
        to top,
        hsl(var(--amq-danger)) 0,
        hsl(var(--amq-danger)) 0.28em,
        transparent 0.28em
      );
    }

    .dark .amq-underline--danger {
      background-image: linear-gradient(
        to top,
        hsl(var(--amq-danger)) 0,
        hsl(var(--amq-danger)) 0.28em,
        transparent 0.28em
      );
    }

    .amq-underline--success {
      background-image: linear-gradient(
        to top,
        hsl(var(--amq-success)) 0,
        hsl(var(--amq-success)) 0.28em,
        transparent 0.28em
      );
    }

    .dark .amq-underline--success {
      background-image: linear-gradient(
        to top,
        hsl(var(--amq-success)) 0,
        hsl(var(--amq-success)) 0.28em,
        transparent 0.28em
      );
    }

    /* In the Problem/Solution section, underlines "draw in" when the section enters view */
    #amiquus-probsol .amq-underline {
      background-size: 0% 0.28em; /* start hidden */
    }

    .amq-underline--animate {
      animation: amqUnderlineGrow 0.6s cubic-bezier(0.2, 0.9, 0.25, 1.15) forwards;
      animation-delay: var(--amq-underline-delay, 0s);
    }

    @keyframes amqUnderlineGrow {
      0% {
        background-size: 0% 0.28em;
      }
      100% {
        background-size: 100% 0.28em;
      }
    }
  </style>

  <script>
    // Reveal on scroll (section-safe) + underline trigger on every entry
    (function () {
      const root = document.getElementById('amiquus-probsol');
      if (!root) return;

      const els = root.querySelectorAll('.will-animate');
      const underlineEls = Array.from(root.querySelectorAll('.amq-underline'));

      // Fallback: no IntersectionObserver support → show everything + static underline
      if (!('IntersectionObserver' in window)) {
        els.forEach((el) => el.classList.add('in-view'));
        underlineEls.forEach((el) => {
          el.style.setProperty('--amq-underline-delay', '0s');
          el.classList.add('amq-underline--animate');
        });
        return;
      }

      // Fade / slide-in for cards, once
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('in-view');
              io.unobserve(e.target);
            }
          });
        },
        { threshold: 0.15, rootMargin: '0px 0px -10% 0px' }
      );

      els.forEach((el) => io.observe(el));

      // Underline animation: re-trigger every time the whole section comes into view
      function triggerUnderlineAnimation() {
        underlineEls.forEach((el, index) => {
          // Remove to reset
          el.classList.remove('amq-underline--animate');

          // Force reflow so animation can restart
          // eslint-disable-next-line @typescript-eslint/no-unused-expressions
          void el.offsetWidth;

          // Slightly varied timing per underline (stagger + small random)
          const base = 0.08 * index; // stagger
          const jitter = Math.random() * 0.12; // random offset
          const delay = (base + jitter).toFixed(3) + 's';

          el.style.setProperty('--amq-underline-delay', delay);
          el.classList.add('amq-underline--animate');
        });
      }

      const sectionIO = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              triggerUnderlineAnimation();
            }
          });
        },
        { threshold: 0.35 } // section reasonably in view
      );

      sectionIO.observe(root);
    })();

    // ===== HERO FOREGROUND + GLOBAL FLOAT BACKGROUND =====
    (function () {
      const hero = document.getElementById('amiquus-hero');
      const floatLayer = document.getElementById('hero-float-layer');
      const mainWrap = document.getElementById('hero-main-wrap');
      const finalOverlay = document.getElementById('hero-final-overlay');
      if (!hero || !floatLayer || !mainWrap || !finalOverlay) return;

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const cars = [
        { brand: 'BMW', model: '320d Touring', price: '€18,900', img: '/homepage/demo-cars/bmw_320d_touring_hero_image.webp' },
        { brand: 'Audi', model: 'A4 Avant', price: '€21,450', img: '/homepage/demo-cars/audi_a4_avant_hero_image.webp' },
        { brand: 'Mercedes', model: 'C220d AMG', price: '€23,100', img: '/homepage/demo-cars/mercedes_c220d_amg_hero_image.webp' },
        { brand: 'VW', model: 'Golf GTI', price: '€17,990', img: '/homepage/demo-cars/vw_golf_gti_hero_image.webp' },
        { brand: 'Škoda', model: 'Octavia RS', price: '€19,800', img: '/homepage/demo-cars/skoda_octavia_rs_hero_image.webp' },
        { brand: 'Tesla', model: 'Model 3 LR', price: '€29,900', img: '/homepage/demo-cars/tesla_model_3_lr_hero_image.webp' },

        // background pool
        { brand: 'Volvo', model: 'V60 D4', price: '€22,750', img: '/homepage/demo-cars/volvo_v60_d4_hero_image.webp' },
        { brand: 'Peugeot', model: '3008 GT', price: '€16,700', img: '/homepage/demo-cars/peugeot_3008_gt_hero_image.webp' },
        { brand: 'Renault', model: 'Megane RS', price: '€15,400', img: '/homepage/demo-cars/renault_megane_rs_hero_image.webp' },
        { brand: 'Toyota', model: 'RAV4 Hybrid', price: '€24,300', img: '/homepage/demo-cars/toyota_rav4_hybrid_hero_image.webp' },
        { brand: 'Ford', model: 'Focus ST', price: '€14,980', img: '/homepage/demo-cars/ford_focus_st_hero_image.webp' },
        { brand: 'Kia', model: 'Ceed SW', price: '€13,200', img: '/homepage/demo-cars/kia_ceed_sw_hero_image.webp' }
      ];

      const foreground = cars.slice(0, 6);
      const backgroundPool = cars.slice(6);

      function createCard(car, cls) {
        const card = document.createElement('article');
        card.className = cls;
        card.setAttribute('role', 'listitem');
        card.setAttribute('aria-label', `${car.brand} ${car.model} at ${car.price}`);

        card.innerHTML = `
          <div class="hero-card-img">
            <img
              src="${car.img}"
              alt="${car.brand} ${car.model}"
              loading="eager"
              decoding="async"
              onerror="this.style.display='none'; this.parentElement.innerHTML='<div style=&quot;color: rgb(var(--muted-foreground)); font-weight:700; font-size:0.95rem;&quot;>Car photo</div>';"
            />
          </div>

          <div class="hero-stamp" aria-hidden="true">OOPS<br>JUST SOLD</div>

          <div class="hero-meta">
            <div>
              <div class="hero-brand">${car.brand}</div>
              <div class="hero-model">${car.model}</div>
              <div class="hero-sub">New listing</div>
            </div>
            <div class="hero-price">${car.price}</div>
          </div>
        `;
        return card;
      }

      // ---------- FLOAT BACKGROUND ENGINE ----------
      let floatNodes = [];
      let rafId = null;
      let lastT = 0;

      function clearFloat() {
        if (rafId) cancelAnimationFrame(rafId);
        rafId = null;
        floatLayer.innerHTML = '';
        floatNodes = [];
        lastT = 0;
      }

      function layoutFloat() {
        clearFloat();

        const rect = hero.getBoundingClientRect();
        const W = rect.width;
        const H = rect.height;

        const count = Math.max(14, Math.min(22, Math.floor(W / 90)));
        const pad = Math.min(70, W * 0.06);
        const minDist = Math.min(220, W * 0.18);

        const placed = [];

        function pickSpot() {
          for (let tries = 0; tries < 120; tries++) {
            const x = pad + Math.random() * (W - pad * 2);
            const y = pad + Math.random() * (H - pad * 2);
            let ok = true;
            for (const p of placed) {
              const d = Math.hypot(x - p.x, y - p.y);
              if (d < minDist) {
                ok = false;
                break;
              }
            }
            if (ok) {
              placed.push({ x, y });
              return { x, y };
            }
          }
          const x = pad + Math.random() * (W - pad * 2);
          const y = pad + Math.random() * (H - pad * 2);
          placed.push({ x, y });
          return { x, y };
        }

        for (let i = 0; i < count; i++) {
          const car = backgroundPool[i % backgroundPool.length];
          const el = createCard(car, 'hero-float-card');

          const { x, y } = pickSpot();

          const scale = 0.6 + Math.random() * 0.75;
          const z = -40 - Math.random() * 420;
          const rot = Math.random() * 28 - 14;
          const rx = Math.random() * 10 - 5;
          const ry = Math.random() * 10 - 5;

          const speed = 0.012 + Math.random() * 0.02;
          const ang = Math.random() * Math.PI * 2;
          const vx = Math.cos(ang) * speed * (0.8 + Math.random() * 0.7);
          const vy = Math.sin(ang) * speed * (0.8 + Math.random() * 0.7);

          const rotV = Math.random() * 0.008 - 0.004;

          el.style.transform = `translate3d(${x}px, ${y}px, ${z}px) translate(-50%,-50%) rotateX(${rx}deg) rotateY(${ry}deg) rotate(${rot}deg) scale(${scale})`;

          floatLayer.appendChild(el);

          floatNodes.push({ el, x, y, vx, vy, rot, rotV, scale, z, rx, ry });
        }

        if (!reduceMotion) {
          rafId = requestAnimationFrame(tick);
        }
      }

      function tick(t) {
        if (!lastT) lastT = t;
        const dt = t - lastT;
        lastT = t;

        const rect = hero.getBoundingClientRect();
        const W = rect.width;
        const H = rect.height;

        for (const n of floatNodes) {
          n.x += n.vx * dt;
          n.y += n.vy * dt;
          n.rot += n.rotV * dt;

          if (n.x < -80) n.x = W + 80;
          if (n.x > W + 80) n.x = -80;
          if (n.y < -80) n.y = H + 80;
          if (n.y > H + 80) n.y = -80;

          n.el.style.transform = `translate3d(${n.x}px, ${n.y}px, ${n.z}px) translate(-50%,-50%) rotateX(${n.rx}deg) rotateY(${n.ry}deg) rotate(${n.rot}deg) scale(${n.scale})`;
        }

        rafId = requestAnimationFrame(tick);
      }

      const ro = new ResizeObserver(() => layoutFloat());
      ro.observe(hero);

      // ---------- FOREGROUND CYCLE ----------
      function spawnMoneyPuffs(targetCard) {
        const symbols = ['€', '$', '£'];
        const count = 14;
        for (let i = 0; i < count; i++) {
          const puff = document.createElement('div');
          puff.className = 'money-puff';

          const sym = symbols[Math.floor(Math.random() * symbols.length)];
          puff.textContent = `-${sym}`;

          const dx = (Math.random() * 240 - 120).toFixed(0) + 'px';
          const rot = (Math.random() * 40 - 20).toFixed(0) + 'deg';
          const size = 1.35 + Math.random() * 1.25;

          puff.style.setProperty('--dx', dx);
          puff.style.setProperty('--rot', rot);
          puff.style.animationDelay = i * 70 + 'ms';
          puff.style.left = 38 + Math.random() * 24 + '%';
          puff.style.top = 82 + Math.random() * 5 + '%';
          puff.style.fontSize = (1.35 * size).toFixed(2) + 'rem';

          targetCard.appendChild(puff);
          puff.addEventListener('animationend', () => puff.remove());
        }
      }

      function spawnAsh(target) {
        const a = document.createElement('div');
        a.className = 'ash';
        target.appendChild(a);
        a.addEventListener('animationend', () => a.remove());
      }

      function applyStamp(card) {
        const stamp = card.querySelector('.hero-stamp');
        if (!stamp) return;

        card.classList.remove('is-stamping');
        stamp.innerHTML = 'OOPS<br>JUST SOLD';
        void stamp.offsetWidth;
        card.classList.add('is-stamping');
      }

      async function showFinalOverlay() {
        finalOverlay.innerHTML = `
          <div class="glass">
            <div class="line1">Missed <span>opportunity</span></div>
            <div class="line2">Missed <span>profit</span></div>
          </div>
        `;
        finalOverlay.classList.add('show');
        await new Promise((r) => setTimeout(r, 3000));
        finalOverlay.classList.remove('show');
      }

      let idx = 0;

      async function cycle() {
        layoutFloat();

        if (reduceMotion) {
          mainWrap.innerHTML = '';
          mainWrap.appendChild(createCard(foreground[0], 'hero-main-card'));
          return;
        }

        while (true) {
          mainWrap.innerHTML = '';
          const car = foreground[idx];
          const card = createCard(car, 'hero-main-card is-entering');
          mainWrap.appendChild(card);

          requestAnimationFrame(() => card.classList.remove('is-entering'));
          await new Promise((r) => setTimeout(r, 1200));

          applyStamp(card);
          await new Promise((r) => setTimeout(r, 850));

          spawnMoneyPuffs(card);
          await new Promise((r) => setTimeout(r, 2200));

          spawnAsh(card);
          card.classList.add('is-ashing');
          await new Promise((r) => setTimeout(r, 950));

          idx++;
          if (idx >= foreground.length) {
            idx = 0;
            await showFinalOverlay();
            await new Promise((r) => setTimeout(r, 550));
          } else {
            await new Promise((r) => setTimeout(r, 260));
          }
        }
      }


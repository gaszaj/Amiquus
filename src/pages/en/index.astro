---
// src/pages/si/index.astro

import BaseLayout from '../../layouts/BaseLayout.astro';

// Page-specific metadata
const title = "Amiquus - Automated Car Listing Alerts";
const description = "Get real-time notifications for new car listings that match your criteria. Monitor multiple platforms automatically with instant Telegram alerts.";

// Props for BaseLayout - simplified to match working pattern
const languageIso = "en";
const countryCode = "US";
const contentOrientation = "ltr";
const languageLinksMap = { 'en': '/en', 'de': '/de' };
---

<BaseLayout
  languageIso={languageIso}
  countryCode={countryCode}
  contentOrientation={contentOrientation}
  title={title}
  description={description}
  languageLinksMap={languageLinksMap}
>
  <!-- Hero Section (REDONE to match screenshot) -->
  <section id="amiquus-hero" class="relative overflow-hidden py-20 sm:py-28 lg:py-32">
    <!-- dark gradient background like screenshot -->
    <div aria-hidden="true" class="absolute inset-0 -z-10 hero-bg"></div>

    <div class="max-w-screen-xl mx-auto px-4">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">
        <!-- Left copy -->
        <div class="text-center lg:text-start animate-on-scroll">
          <h1 class="text-4xl md:text-5xl font-extrabold leading-tight text-foreground mb-5">
            Never Miss Your
            <span class="text-primary">Perfect Car Deal</span>
            Again
          </h1>

          <p class="text-base md:text-lg text-muted-foreground mb-8 max-w-xl mx-auto lg:mx-0">
            Amiquus monitors multiple car listing platforms 24/7 and sends instant Telegram notifications the moment a matching car appears — so you act first, not last.
          </p>

          <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 justify-center lg:justify-start">
            <a
              href="#pricing"
              class="inline-flex items-center justify-center px-6 py-3 rounded-lg font-semibold bg-primary text-primary-foreground shadow-lg hover:opacity-90 transition-transform hover:-translate-y-1"
              aria-label="Go to pricing"
            >
              Pricing
            </a>
            <a
              href="/si/setup-alerts"
              class="inline-flex items-center justify-center px-6 py-3 rounded-lg font-semibold bg-transparent border border-border/70 text-foreground/90 hover:bg-white/5 transition-colors"
              aria-label="Go to setup alerts"
            >
              Get Alerts
            </a>
          </div>
        </div>

        <!-- Right animation stage -->
        <div class="relative animate-on-scroll" data-delay="100" aria-label="Animated missed opportunities preview">
          <div class="relative hero-stage h-[380px] sm:h-[440px] lg:h-[500px] w-full">
            <!-- Stage panel -->
            <div class="absolute inset-0 rounded-2xl hero-stage-panel border border-border/40 overflow-hidden"></div>

            <!-- Background cloud (blurred cards only INSIDE this stage) -->
            <div id="hero-bg-cloud" class="absolute inset-0"></div>

            <!-- Foreground main card -->
            <div id="hero-main-wrap" class="absolute inset-0 grid place-items-center px-6 sm:px-8">
              <!-- injected by script -->
            </div>

            <!-- Final text overlay (after 6 cards) -->
            <div id="hero-final-overlay" class="hero-final-overlay" aria-hidden="true"></div>

            <!-- subtle depth fade at bottom -->
            <div aria-hidden="true" class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-black/40 to-transparent"></div>
          </div>

          <p class="sr-only">
            A single car listing card appears in front while many blurred listings float in the background.
            The front card collapses into ash, euro symbols rise to show missed profit,
            then the next card appears. After six cards, text appears saying missed opportunity and missed profit.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- "PROBLEM / SOLUTION" SECTION (REDONE to match screenshot) -->
  <section id="amiquus-probsol" class="relative py-14 sm:py-20 overflow-hidden" aria-labelledby="probsol-title">
    <div aria-hidden="true" class="absolute inset-0 pointer-events-none probsol-bg"></div>

    <div class="max-w-screen-xl mx-auto px-4">
      <div class="text-center max-w-3xl mx-auto will-animate" data-anim="fade-up">
        <div class="probsol-kicker uppercase tracking-[0.22em] text-xs md:text-sm text-muted-foreground/90 mb-3">
          Problem / Solution
        </div>

        <h2 id="probsol-title" class="text-3xl md:text-4xl lg:text-5xl font-extrabold tracking-tight text-foreground">
          Find the car first.
          <span class="text-primary">Every time.</span>
        </h2>

        <p class="mt-3 text-base md:text-lg text-muted-foreground" aria-live="polite">
          Amiquus watches listings 24/7 and pings you instantly.
        </p>
      </div>

      <div class="mt-8 sm:mt-10 grid grid-cols-1 md:grid-cols-2 gap-5 lg:gap-7" role="list">
        <!-- BAD / OLD WAY -->
        <article role="listitem" aria-label="Old way: manual refreshing"
          class="group relative rounded-2xl p-6 shadow-sm will-animate probsol-card probsol-card--bad"
          data-anim="fade-right">
          <header class="flex items-center gap-3">
            <div class="h-12 w-12 grid place-items-center rounded-xl bg-rose-500/10 text-rose-400">
              <svg viewBox="0 0 24 24" class="h-6 w-6" role="img" aria-label="Hourglass">
                <g>
                  <path fill="currentColor" d="M6 3h12v2a5 5 0 0 1-2.1 4.1L14 10l1.9.9A5 5 0 0 1 18 15v2H6v-2a5 5 0 0 1 2.1-4.1L10 10 8.1 9.1A5 5 0 0 1 6 5V3Z"/>
                  <circle cx="12" cy="10" r="1.4" fill="currentColor" class="sand-top"></circle>
                  <circle cx="12" cy="14" r="1.4" fill="currentColor" class="sand-bot"></circle>
                </g>
              </svg>
            </div>
            <h3 class="text-lg md:text-xl font-semibold text-foreground">
              Manual refreshing
            </h3>
          </header>

          <p class="mt-3 text-sm md:text-base leading-relaxed text-muted-foreground">
            You refresh, <span class="text-rose-400 font-semibold">you miss</span>, you repeat.
          </p>

          <div class="mt-4 flex flex-wrap gap-2">
            <span class="chip md:text-[12px]" style="--chip: var(--amq-danger)">Time sink</span>
            <span class="chip md:text-[12px]" style="--chip: var(--amq-danger)">Missed deals</span>
            <span class="chip md:text-[12px]" style="--chip: var(--amq-danger)">Stress</span>
          </div>

          <div class="mt-5 flex items-center gap-2 text-xs md:text-sm text-muted-foreground">
            <span class="h-2 w-2 rounded-full bg-rose-400/80" aria-hidden="true"></span>
            <span>Live monitoring</span>
          </div>
        </article>

        <!-- GOOD / AMIQUUS WAY -->
        <article role="listitem" aria-label="Amiquus way: automated alerts"
          class="group relative rounded-2xl p-6 shadow-sm will-animate probsol-card probsol-card--good"
          data-anim="fade-left">
          <header class="flex items-center gap-3">
            <div class="h-12 w-12 grid place-items-center rounded-xl bg-emerald-500/10 text-emerald-300">
              <svg viewBox="0 0 24 24" class="h-6 w-6" role="img" aria-label="Notification bell">
                <path fill="currentColor" d="M12 22a2 2 0 0 0 2-2h-4a2 2 0 0 0 2 2Zm7-6V11a7 7 0 1 0-14 0v5l-2 2v1h18v-1l-2-2Z"/>
                <circle class="ping-dot" cx="18" cy="6" r="2" fill="currentColor"/>
              </svg>
            </div>
            <h3 class="text-lg md:text-xl font-semibold text-foreground">
              Automated alerts
            </h3>
          </header>

          <p class="mt-3 text-sm md:text-base leading-relaxed text-muted-foreground">
            <span class="font-semibold text-emerald-300">We scan.</span>
            <span class="text-sky-300 font-semibold">Telegram pings you</span>. You act first.
          </p>

          <div class="mt-4 flex flex-wrap gap-2">
            <span class="chip md:text-[12px]" style="--chip: var(--amq-success)">24/7 scan</span>
            <span class="chip md:text-[12px]" style="--chip: var(--amq-success)">Instant ping</span>
            <span class="chip md:text-[12px]" style="--chip: var(--amq-success)">Full coverage</span>
          </div>

          <div class="mt-5 flex items-center justify-between">
            <div class="flex items-center gap-2 text-xs md:text-sm text-muted-foreground">
              <span class="h-2 w-2 rounded-full bg-emerald-400/80" aria-hidden="true"></span>
              <span>Instant ping</span>
            </div>
            <a href="#order"
               aria-label="Get ahead of others. Start in 60 seconds."
               class="cta-btn inline-flex items-center justify-center gap-2 rounded-full px-4 py-2 text-sm md:text-[15px] font-semibold">
              <span class="whitespace-nowrap">Get ahead of others</span>
              <svg viewBox="0 0 24 24" class="h-4 w-4 md:h-5 md:w-5" role="img" aria-label="Arrow">
                <path fill="currentColor" d="M13 5l7 7-7 7v-4H4v-6h9V5z"/>
              </svg>
            </a>
          </div>
        </article>
      </div>

      <div class="mt-7 sm:mt-8 flex flex-col sm:flex-row items-center justify-center gap-4 will-animate" data-anim="fade-up" aria-label="Trust indicators">
        <div class="flex items-center gap-2 text-xs md:text-sm text-muted-foreground">
          <span class="i-badge" aria-hidden="true"></span>
          <span>Checks listings every ~15s on supported sites</span>
        </div>
        <div class="hidden sm:block h-4 w-px bg-border/40" aria-hidden="true"></div>
        <div class="flex items-center gap-2 text-xs md:text-sm text-muted-foreground">
          <span class="i-shield" aria-hidden="true"></span>
          <span>No spam. Cancel anytime.</span>
        </div>
      </div>
    </div>
  </section>

  <style>
    /* ===== HERO LOOK (match screenshot) ===== */
    #amiquus-hero .hero-bg{
      background:
        radial-gradient(80rem 40rem at 0% -10%, rgb(var(--amq-primary)/.22) 0%, transparent 60%),
        radial-gradient(60rem 30rem at 90% 10%, rgb(var(--amq-success)/.18) 0%, transparent 60%),
        linear-gradient(180deg, rgb(4 8 18) 0%, rgb(7 10 20) 40%, rgb(7 9 16) 100%);
    }
    #amiquus-hero{
      color-scheme: dark;
    }
    #amiquus-hero .text-muted-foreground{
      color: rgb(var(--amq-muted));
    }

    .hero-stage{
      filter: drop-shadow(0 30px 60px rgb(0 0 0 / .45));
    }
    .hero-stage-panel{
      background:
        radial-gradient(120% 100% at 20% 0%, rgb(255 255 255 / .06) 0%, transparent 60%),
        linear-gradient(180deg, rgb(255 255 255 / .04), rgb(255 255 255 / .02));
      backdrop-filter: blur(8px);
    }

    /* ===== PROBLEM/SOLUTION LOOK (glass cards) ===== */
    #amiquus-probsol{
      color-scheme: dark;
      background:
        radial-gradient(60rem 20rem at 50% -20%, rgb(var(--amq-primary)/.12), transparent 70%),
        linear-gradient(180deg, rgb(6 9 18) 0%, rgb(6 8 14) 100%);
      border-top: 1px solid rgb(var(--border)/.25);
      border-bottom: 1px solid rgb(var(--border)/.25);
    }
    #amiquus-probsol .probsol-bg{
      background:
        radial-gradient(30rem 18rem at 10% 10%, rgb(var(--amq-primary)/.10) 0%, transparent 60%),
        radial-gradient(30rem 18rem at 90% 0%, rgb(var(--amq-success)/.10) 0%, transparent 60%);
      opacity:.9;
    }
    #amiquus-probsol .probsol-kicker{
      color: rgb(var(--amq-muted));
    }

    .probsol-card{
      background:
        radial-gradient(140% 120% at 0% 0%, rgb(255 255 255 / .05) 0%, transparent 55%),
        linear-gradient(180deg, rgb(14 18 30 / .9), rgb(10 14 25 / .9));
      border: 1px solid rgb(var(--border)/.35);
      backdrop-filter: blur(8px);
    }
    .probsol-card--bad{
      box-shadow: 0 18px 60px rgb(244 63 94 / .10);
    }
    .probsol-card--good{
      box-shadow: 0 18px 60px rgb(16 185 129 / .10);
    }

    /* Chips */
    #amiquus-probsol .chip{
      display:inline-flex; align-items:center; justify-content:center;
      padding:.25rem .625rem; font-size:.75rem; border-radius:9999px;
      border:1px solid rgb(var(--chip) / .35); color: rgb(var(--chip) / .95);
      background: linear-gradient(180deg, rgb(var(--chip)/.12), rgb(var(--chip)/.05));
    }

    /* Animations in prob/sol (unchanged behavior, new theme) */
    @media (prefers-reduced-motion:no-preference){
      #amiquus-probsol .will-animate{opacity:0;transform:translateY(12px);transition:opacity .6s ease, transform .6s ease}
      #amiquus-probsol .will-animate.in-view{opacity:1;transform:none}
      #amiquus-probsol [data-anim="fade-right"]{transform:translateX(-12px)}
      #amiquus-probsol [data-anim="fade-left"]{transform:translateX(12px)}
      #amiquus-probsol .in-view[data-anim="fade-right"],
      #amiquus-probsol .in-view[data-anim="fade-left"]{transform:none}

      .sand-top{animation:sandTop 2.2s infinite ease-in-out}
      .sand-bot{animation:sandBot 2.2s infinite ease-in-out}
      @keyframes sandTop{0%{opacity:1;transform:translateY(0)}50%{opacity:.2;transform:translateY(4px)}100%{opacity:1;transform:translateY(0)}}
      @keyframes sandBot{0%{opacity:.2;transform:translateY(-4px)}50%{opacity:1;transform:translateY(0)}100%{opacity:.2;transform:translateY(-4px)}}

      .ping-dot{animation:pingDot 1.6s ease-in-out infinite}
      @keyframes pingDot{0%,100%{opacity:.5;transform:scale(.9)}50%{opacity:1;transform:scale(1.15)}}
    }

    .cta-btn{
      color:white;
      background: linear-gradient(90deg, rgb(var(--amq-primary)), rgb(var(--amq-success)));
      background-size:200% 100%;
      animation:ctaGradient 5s linear infinite, ctaPulseDark 1.8s ease-in-out infinite;
      box-shadow: 0 8px 30px rgb(0 0 0 / .35);
    }
    @keyframes ctaGradient{0%{background-position:0% 50%}100%{background-position:100% 50%}}
    @keyframes ctaPulseDark{
      0%{box-shadow:0 0 0 0 rgb(var(--amq-primary)/.55)}
      70%{box-shadow:0 0 0 14px rgb(var(--amq-primary)/0)}
      100%{box-shadow:0 0 0 0 rgb(var(--amq-primary)/0)}
    }

    /* ===== HERO ANIMATION PACK (updated collapse-to-ash) ===== */
    #hero-bg-cloud { perspective: 1200px; }

    .hero-bg-card,
    .hero-main-card {
      position: absolute;
      border-radius: 1rem;
      overflow: hidden;
      background: rgb(var(--card));
      border: 1px solid rgb(var(--border));
      box-shadow:
        0 14px 36px rgb(0 0 0 / 0.18),
        0 2px 10px rgb(0 0 0 / 0.10);
      will-change: transform, opacity, filter;
    }

    .hero-bg-card {
      width: clamp(145px, 34%, 230px);
      filter: blur(5px) saturate(.9);
      opacity: 0.45;
      transform-style: preserve-3d;
      animation: bgWiggle 5.2s ease-in-out infinite;
    }

    @keyframes bgWiggle {
      0%,100% { transform: translate3d(var(--x), var(--y), var(--z)) rotate(var(--r)) scale(var(--s)); }
      50% { transform: translate3d(calc(var(--x) + 8px), calc(var(--y) - 10px), var(--z)) rotate(calc(var(--r) + 1.2deg)) scale(var(--s)); }
    }

    .hero-main-card {
      position: relative;
      width: min(92%, 420px);
      transform: translateY(0) scale(1);
      animation: mainWiggle 1.3s ease-in-out infinite;
    }
    @keyframes mainWiggle {
      0%,100% { transform: translateY(0) rotate(-0.6deg); }
      50% { transform: translateY(-3px) rotate(0.6deg); }
    }

    .hero-card-img {
      height: 210px;
      background: rgb(var(--muted));
      display: grid;
      place-items: center;
    }
    .hero-card-img img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .hero-meta {
      padding: 0.9rem 1rem;
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 0.5rem 0.75rem;
      align-items: center;
      background: linear-gradient(180deg, rgb(255 255 255 / .02), transparent);
    }
    .hero-brand {
      font-weight: 800;
      font-size: 1.05rem;
      color: rgb(var(--amq-primary));
      line-height: 1.15;
    }
    .hero-model {
      font-weight: 700;
      font-size: 0.98rem;
      color: rgb(var(--foreground));
      opacity: 0.95;
    }
    .hero-price {
      font-weight: 900;
      font-size: 1.15rem;
      color: rgb(var(--amq-success));
      white-space: nowrap;
      text-shadow: 0 6px 18px rgb(0 0 0 / .12);
    }
    .hero-sub {
      font-size: 0.8rem;
      color: rgb(var(--muted-foreground));
      margin-top: 0.1rem;
    }

    .hero-main-card.is-entering {
      opacity: 0;
      transform: translateY(14px) scale(0.985);
      filter: blur(1px);
    }

    /* collapse to ash + sink */
    .hero-main-card.is-ashing {
      opacity: 0;
      transform: translateY(60px) scale(0.9) rotateX(12deg);
      filter: blur(6px) grayscale(1);
      transition: transform 900ms ease, opacity 900ms ease, filter 900ms ease;
      pointer-events: none;
    }

    .ash {
      position: absolute;
      left: 8%;
      right: 8%;
      bottom: 10px;
      height: 18px;
      background: radial-gradient(closest-side, rgb(255 255 255 / .22), transparent 70%);
      filter: blur(8px);
      opacity: 0;
      animation: ashPoof 950ms ease forwards;
    }
    @keyframes ashPoof {
      0% { opacity: 0; transform: scale(.6) translateY(0); }
      25% { opacity: .7; transform: scale(1) translateY(-2px); }
      100% { opacity: 0; transform: scale(1.5) translateY(6px); }
    }

    .money-puff {
      position: absolute;
      left: 75%;
      top: 70%;
      transform: translate(-50%,-50%);
      font-weight: 900;
      color: rgb(var(--amq-danger));
      text-shadow: 0 8px 24px rgb(0 0 0 / .35);
      pointer-events: none;
      opacity: 0;
      animation: moneyPuff 1050ms ease forwards;
      font-size: 1.4rem;
    }
    @keyframes moneyPuff {
      0%   { opacity: 0; transform: translate(-50%,-50%) scale(.6); }
      15%  { opacity: 1; transform: translate(-50%,-70%) scale(1); }
      100% { opacity: 0; transform: translate(calc(-50% + var(--dx)), calc(-50% - 120px)) scale(1.25); }
    }

    .hero-final-overlay {
      position: absolute;
      inset: 0;
      display: grid;
      place-items: center;
      text-align: center;
      font-weight: 900;
      letter-spacing: .3px;
      color: white;
      background: rgb(0 0 0 / 0.40);
      opacity: 0;
      transform: scale(0.98);
      pointer-events: none;
      backdrop-filter: blur(4px);
    }
    .hero-final-overlay.show {
      animation: finalOverlay 2200ms ease forwards;
    }
    .hero-final-overlay .line1 {
      font-size: clamp(1.4rem, 3vw, 2rem);
      text-transform: uppercase;
    }
    .hero-final-overlay .line2 {
      margin-top: .35rem;
      font-size: clamp(1.1rem, 2.4vw, 1.6rem);
      color: rgb(var(--amq-danger));
      text-transform: uppercase;
      text-shadow: 0 8px 24px rgb(0 0 0 / .3);
    }
    @keyframes finalOverlay {
      0% { opacity: 0; transform: scale(.98); }
      15% { opacity: 1; transform: scale(1); }
      85% { opacity: 1; transform: scale(1); }
      100% { opacity: 0; transform: scale(1.02); }
    }
  </style>

  <script>
    // One-time reveal on scroll (scoped to prob/sol)
    (function(){
      const root = document.getElementById('amiquus-probsol');
      if(!root) return;
      const els = root.querySelectorAll('.will-animate');
      if(!('IntersectionObserver' in window)){ els.forEach(el=> el.classList.add('in-view')); return; }
      const io=new IntersectionObserver((entries)=>{
        entries.forEach(e=>{ if(e.isIntersecting){ e.target.classList.add('in-view'); io.unobserve(e.target); }});
      },{threshold:.15,rootMargin:'0px 0px -10% 0px'});
      els.forEach(el=> io.observe(el));
    })();

    // ===== HERO FOREGROUND + BACKGROUND ANIMATION =====
    (function(){
      const bgCloud = document.getElementById('hero-bg-cloud');
      const mainWrap = document.getElementById('hero-main-wrap');
      const finalOverlay = document.getElementById('hero-final-overlay');
      if(!bgCloud || !mainWrap || !finalOverlay) return;

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const cars = [
        { brand:"BMW", model:"320d Touring", price:"€18,900", img:"/homepage/demo-cars/car-01.webp" },
        { brand:"Audi", model:"A4 Avant", price:"€21,450", img:"/homepage/demo-cars/car-02.webp" },
        { brand:"Mercedes", model:"C220d AMG", price:"€23,100", img:"/homepage/demo-cars/car-03.webp" },
        { brand:"VW", model:"Golf GTI", price:"€17,990", img:"/homepage/demo-cars/car-04.webp" },
        { brand:"Škoda", model:"Octavia RS", price:"€19,800", img:"/homepage/demo-cars/car-05.webp" },
        { brand:"Tesla", model:"Model 3 LR", price:"€29,900", img:"/homepage/demo-cars/car-06.webp" },
        // background pool
        { brand:"Volvo", model:"V60 D4", price:"€22,750", img:"/homepage/demo-cars/car-07.webp" },
        { brand:"Peugeot", model:"3008 GT", price:"€16,700", img:"/homepage/demo-cars/car-08.webp" },
        { brand:"Renault", model:"Megane RS", price:"€15,400", img:"/homepage/demo-cars/car-09.webp" },
        { brand:"Toyota", model:"RAV4 Hybrid", price:"€24,300", img:"/homepage/demo-cars/car-10.webp" },
        { brand:"Ford", model:"Focus ST", price:"€14,980", img:"/homepage/demo-cars/car-11.webp" },
        { brand:"Kia", model:"Ceed SW", price:"€13,200", img:"/homepage/demo-cars/car-12.webp" },
      ];

      const foreground = cars.slice(0, 6);
      const background = cars.slice(6);

      function createCard(car, cls){
        const card = document.createElement('article');
        card.className = cls;
        card.setAttribute('role','listitem');
        card.setAttribute('aria-label', `${car.brand} ${car.model} at ${car.price}`);
        card.innerHTML = `
          <div class="hero-card-img">
            <img
              src="${car.img}"
              alt="${car.brand} ${car.model}"
              loading="eager"
              decoding="async"
              onerror="this.style.display='none'; this.parentElement.innerHTML='<div style=&quot;color: rgb(var(--muted-foreground)); font-weight:700; font-size:0.95rem;&quot;>Car photo</div>';"
            />
          </div>
          <div class="hero-meta">
            <div>
              <div class="hero-brand">${car.brand}</div>
              <div class="hero-model">${car.model}</div>
              <div class="hero-sub">New listing</div>
            </div>
            <div class="hero-price">${car.price}</div>
          </div>
        `;
        return card;
      }

      function renderBackground(){
        bgCloud.innerHTML = '';
        background.forEach((car) => {
          const c = createCard(car, 'hero-bg-card');
          const x = Math.round((Math.random()*80 - 40)) + '%';
          const y = Math.round((Math.random()*70 - 35)) + '%';
          const z = Math.round(Math.random()*-280 - 60) + 'px';
          const s = (0.82 + Math.random()*0.25).toFixed(2);
          const r = (Math.random()*10 - 5).toFixed(1) + 'deg';

          c.style.setProperty('--x', x);
          c.style.setProperty('--y', y);
          c.style.setProperty('--z', z);
          c.style.setProperty('--s', s);
          c.style.setProperty('--r', r);

          c.style.left = '50%';
          c.style.top = '50%';
          c.style.transform = `translate3d(${x}, ${y}, ${z}) rotate(${r}) scale(${s})`;
          c.style.animationDelay = (Math.random()*2.2).toFixed(2) + 's';

          bgCloud.appendChild(c);
        });
      }

      function spawnMoneyPuffs(target){
        const count = 4;
        for(let i=0;i<count;i++){
          const puff = document.createElement('div');
          puff.className = 'money-puff';
          puff.textContent = '€';
          puff.style.setProperty('--dx', (Math.random()*90 - 45).toFixed(0) + 'px');
          puff.style.animationDelay = (i*80) + 'ms';
          target.appendChild(puff);
          puff.addEventListener('animationend', ()=> puff.remove());
        }
      }

      function spawnAsh(target){
        const a = document.createElement('div');
        a.className = 'ash';
        target.appendChild(a);
        a.addEventListener('animationend', ()=> a.remove());
      }

      async function showFinalOverlay(){
        finalOverlay.innerHTML = `
          <div>
            <div class="line1">Missed opportunity</div>
            <div class="line2">Missed profit</div>
          </div>
        `;
        finalOverlay.classList.add('show');
        await new Promise(r => setTimeout(r, 2200));
        finalOverlay.classList.remove('show');
      }

      let idx = 0;

      async function cycle(){
        if(reduceMotion){
          renderBackground();
          mainWrap.innerHTML = '';
          mainWrap.appendChild(createCard(foreground[0], 'hero-main-card'));
          return;
        }

        renderBackground();

        while(true){
          mainWrap.innerHTML = '';
          const car = foreground[idx];
          const card = createCard(car, 'hero-main-card is-entering');
          mainWrap.appendChild(card);

          requestAnimationFrame(() => card.classList.remove('is-entering'));
          await new Promise(r => setTimeout(r, 1450));

          // collapse to ash + money loss
          spawnMoneyPuffs(card);
          spawnAsh(card);
          card.classList.add('is-ashing');
          await new Promise(r => setTimeout(r, 950));

          idx++;
          if(idx >= foreground.length){
            idx = 0;
            await showFinalOverlay();
            await new Promise(r => setTimeout(r, 450));
            renderBackground();
          } else {
            await new Promise(r => setTimeout(r, 200));
            renderBackground();
          }
        }
      }

      cycle();
    })();
  </script>


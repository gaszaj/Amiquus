---
// src/pages/si/index.astro

import BaseLayout from '../../layouts/BaseLayout.astro';

// Page-specific metadata
const title = "Amiquus - Automated Car Listing Alerts";
const description = "Get real-time notifications for new car listings that match your criteria. Monitor multiple platforms automatically with instant Telegram alerts.";

// Props for BaseLayout - simplified to match working pattern
const languageIso = "en";
const countryCode = "US";
const contentOrientation = "ltr";
const languageLinksMap = { 'en': '/en', 'de': '/de' };
---

<BaseLayout
  languageIso={languageIso}
  countryCode={countryCode}
  contentOrientation={contentOrientation}
  title={title}
  description={description}
  languageLinksMap={languageLinksMap}
>
  <!-- Hero Section -->
  <section
    id="amiquus-hero"
    class="relative overflow-hidden py-20 sm:py-28 lg:py-32"
    aria-label="Amiquus hero section"
  >
    <!-- gradient background -->
    <div aria-hidden="true" class="absolute inset-0 -z-20 bg-background"></div>

    <!-- hero-wide floating background layer -->
    <div
      id="hero-float-layer"
      aria-hidden="true"
      class="absolute inset-0 -z-10 pointer-events-none"
    ></div>

    <div class="relative z-10 max-w-screen-xl mx-auto px-4">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">
        <!-- Left copy -->
        <div class="text-center lg:text-start animate-on-scroll">
          <h1 class="text-4xl md:text-5xl font-extrabold leading-tight text-foreground mb-5">
            Never Miss Your
            <span class="text-primary">Perfect Car Deal</span>
            Again
          </h1>

          <p class="text-base md:text-lg text-muted-foreground mb-8 max-w-xl mx-auto lg:mx-0">
            Amiquus monitors multiple car listing platforms 24/7 and sends instant Telegram notifications the moment a matching car appears — so you act first, not last.
          </p>

          <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 justify-center lg:justify-start">
            <a
              href="#pricing"
              class="inline-flex items-center justify-center px-6 py-3 rounded-lg font-semibold bg-primary text-primary-foreground shadow-lg hover:opacity-90 transition-transform hover:-translate-y-1"
              aria-label="Go to pricing"
            >
              Pricing
            </a>
            <a
              href="/si/setup-alerts"
              class="inline-flex items-center justify-center px-6 py-3 rounded-lg font-semibold bg-transparent border border-border/70 text-foreground/90 hover:bg-white/5 transition-colors"
              aria-label="Go to setup alerts"
            >
              Get Alerts
            </a>
          </div>
        </div>

        <!-- Right animation stage -->
        <div class="relative animate-on-scroll" data-delay="100" aria-label="Animated missed opportunities preview">
          <div class="relative hero-stage h-[380px] sm:h-[440px] lg:h-[500px] w-full">
            <!-- Stage panel (no ugly frame) -->
            <div class="absolute inset-0 rounded-3xl hero-stage-panel overflow-hidden"></div>

            <!-- Foreground main card -->
            <div id="hero-main-wrap" class="absolute inset-0 grid place-items-center px-6 sm:px-8">
              <!-- injected by script -->
            </div>

            <!-- Final text overlay (after 6 cards) -->
            <div id="hero-final-overlay" class="hero-final-overlay" aria-hidden="true"></div>

            <!-- subtle depth fade at bottom -->
            <div aria-hidden="true" class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-black/30 to-transparent dark:from-black/50"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- "PROBLEM / SOLUTION" SECTION -->
  <section id="amiquus-probsol" class="relative py-14 sm:py-20 overflow-hidden" aria-labelledby="probsol-title">
    <div aria-hidden="true" class="absolute inset-0 pointer-events-none bg-background"></div>

    <div class="max-w-screen-xl mx-auto px-4">
      <div class="text-center max-w-3xl mx-auto will-animate" data-anim="fade-up">
        <div class="probsol-kicker uppercase tracking-[0.22em] text-xs md:text-sm text-muted-foreground/90 mb-3">
          Problem / Solution
        </div>

        <h2 id="probsol-title" class="text-3xl md:text-4xl lg:text-5xl font-extrabold tracking-tight text-foreground">
          Find the car first.
          <span class="text-primary">Every time.</span>
        </h2>

        <p class="mt-3 text-base md:text-lg text-muted-foreground" aria-live="polite">
          Amiquus watches listings 24/7 and pings you instantly.
        </p>
      </div>

      <div class="mt-8 sm:mt-10 grid grid-cols-1 md:grid-cols-2 gap-5 lg:gap-7" role="list">
        <!-- BAD / OLD WAY -->
        <article role="listitem" aria-label="Old way: manual refreshing"
          class="group relative rounded-2xl p-6 shadow-sm will-animate probsol-card probsol-card--bad"
          data-anim="fade-right">
          <header class="flex items-center gap-3">
            <div class="h-12 w-12 grid place-items-center rounded-xl probsol-icon probsol-icon--bad">
              <svg viewBox="0 0 24 24" class="h-6 w-6" role="img" aria-label="Hourglass">
                <g>
                  <path fill="currentColor" d="M6 3h12v2a5 5 0 0 1-2.1 4.1L14 10l1.9.9A5 5 0 0 1 18 15v2H6v-2a5 5 0 0 1 2.1-4.1L10 10 8.1 9.1A5 5 0 0 1 6 5V3Z"/>
                  <circle cx="12" cy="10" r="1.4" fill="currentColor" class="sand-top"></circle>
                  <circle cx="12" cy="14" r="1.4" fill="currentColor" class="sand-bot"></circle>
                </g>
              </svg>
            </div>
            <h3 class="text-lg md:text-xl font-semibold text-foreground">
              Manual refreshing
            </h3>
          </header>

          <p class="mt-3 text-sm md:text-base leading-relaxed text-muted-foreground">
            You refresh, <span class="probsol-bad-accent font-semibold">you miss</span>, you repeat.
          </p>

          <div class="mt-4 flex flex-wrap gap-2">
            <span class="chip md:text-[12px]" style="--chip: 0 84% 55%;">Time sink</span>
            <span class="chip md:text-[12px]" style="--chip: 0 84% 55%;">Missed deals</span>
            <span class="chip md:text-[12px]" style="--chip: 0 84% 55%;">Stress</span>
          </div>

          <div class="mt-5 flex items-center gap-2 text-xs md:text-sm text-muted-foreground">
            <span class="h-2 w-2 rounded-full probsol-dot-bad" aria-hidden="true"></span>
            <span>Slow reactions</span>
          </div>
        </article>

        <!-- GOOD / AMIQUUS WAY -->
        <article role="listitem" aria-label="Amiquus way: automated alerts"
          class="group relative rounded-2xl p-6 shadow-sm will-animate probsol-card probsol-card--good"
          data-anim="fade-left">
          <header class="flex items-center gap-3">
            <div class="h-12 w-12 grid place-items-center rounded-xl probsol-icon probsol-icon--good">
              <svg viewBox="0 0 24 24" class="h-6 w-6" role="img" aria-label="Notification bell">
                <path fill="currentColor" d="M12 22a2 2 0 0 0 2-2h-4a2 2 0 0 0 2 2Zm7-6V11a7 7 0 1 0-14 0v5l-2 2v1h18v-1l-2-2Z"/>
                <circle class="ping-dot" cx="18" cy="6" r="2" fill="currentColor"/>
              </svg>
            </div>
            <h3 class="text-lg md:text-xl font-semibold text-foreground">
              Automated alerts
            </h3>
          </header>

          <p class="mt-3 text-sm md:text-base leading-relaxed text-muted-foreground">
            <span class="probsol-good-accent font-semibold">We scan.</span>
            <span class="probsol-good-accent-2 font-semibold">Telegram pings you</span>. You act first.
          </p>

          <div class="mt-4 flex flex-wrap gap-2">
            <span class="chip md:text-[12px]" style="--chip: 142 76% 36%;">24/7 scan</span>
            <span class="chip md:text-[12px]" style="--chip: 142 76% 36%;">Instant ping</span>
            <span class="chip md:text-[12px]" style="--chip: 142 76% 36%;">Full coverage</span>
          </div>

          <div class="mt-5 flex items-center justify-between">
            <div class="flex items-center gap-2 text-xs md:text-sm text-muted-foreground">
              <span class="h-2 w-2 rounded-full probsol-dot-good" aria-hidden="true"></span>
              <span>Instant ping</span>
            </div>
            <a href="/setup-alerts"
               aria-label="Get ahead of others. Start in 60 seconds."
               class="cta-btn inline-flex items-center justify-center gap-2 rounded-full px-4 py-2 text-sm md:text-[15px] font-semibold">
              <span class="whitespace-nowrap">Get ahead of others</span>
              <svg viewBox="0 0 24 24" class="h-4 w-4 md:h-5 md:w-5" role="img" aria-label="Arrow">
                <path fill="currentColor" d="M13 5l7 7-7 7v-4H4v-6h9V5z"/>
              </svg>
            </a>
          </div>
        </article>
      </div>

      <div class="mt-7 sm:mt-8 flex flex-col sm:flex-row items-center justify-center gap-4 will-animate" data-anim="fade-up" aria-label="Trust indicators">
        <div class="flex items-center gap-2 text-xs md:text-sm text-muted-foreground">
          <span class="i-badge" aria-hidden="true"></span>
          <span>Checks listings every ~15s on supported sites</span>
        </div>
        <div class="hidden sm:block h-4 w-px bg-border/40" aria-hidden="true"></div>
        <div class="flex items-center gap-2 text-xs md:text-sm text-muted-foreground">
          <span class="i-shield" aria-hidden="true"></span>
          <span>No spam. Cancel anytime.</span>
        </div>
      </div>
    </div>
  </section>

  <!-- IMPORTANT: is:global so injected hero cards receive styles -->
  <style is:global>
    /* =========================================================
       HERO + PROBSOL are global, theme-safe, and token-based
       ========================================================= */

    /* ---------- HERO THEME ---------- */
    #amiquus-hero {
      position: relative;

      /* CHANGE #1: no rounded bottom edges */
      border-bottom-left-radius: 0;
      border-bottom-right-radius: 0;
      overflow: hidden;

      --destructive: 0 84% 55%;

      /* Light mode should match other bg-background sections */
      --hero-bg-a: var(--background);
      --hero-bg-b: var(--background);
      --hero-bg-c: var(--background);

      --hero-stage-glass: rgba(255,255,255,.80);
      --hero-stage-glass-2: rgba(255,255,255,.58);
      --hero-stage-border: rgba(0,0,0,.06);

      --hero-card-glass: rgba(255,255,255,.94);
      --hero-card-glass-2: rgba(255,255,255,.78);
      --hero-card-border: rgba(0,0,0,.10);

      --hero-float-opacity: .34;
      --hero-float-blur: 7px;

      --money-red: 0 84% 55%;
    }

    .dark #amiquus-hero {
      --destructive: 0 84% 55%;

      --hero-bg-a: 225 85% 14%;
      --hero-bg-b: 160 70% 12%;
      --hero-bg-c: 230 55% 8%;

      --hero-stage-glass: rgba(8,12,22,.72);
      --hero-stage-glass-2: rgba(8,12,22,.48);
      --hero-stage-border: rgba(255,255,255,.14);

      --hero-card-glass: rgba(10,14,25,.84);
      --hero-card-glass-2: rgba(10,14,25,.62);
      --hero-card-border: rgba(255,255,255,.16);

      --hero-float-opacity: .30;
      --hero-float-blur: 10px;

      --money-red: 0 84% 55%;
    }

    /* Light mode hero background: FLAT like other sections */
    #amiquus-hero .hero-bg {
      background: hsl(var(--background));
    }
    /* Dark mode hero background: keep your moody gradient */
    .dark #amiquus-hero .hero-bg {
      background:
        radial-gradient(70rem 38rem at 0% -10%, hsl(var(--hero-bg-a)) 0%, transparent 60%),
        radial-gradient(60rem 30rem at 95% 10%, hsl(var(--hero-bg-b)) 0%, transparent 60%),
        linear-gradient(180deg, hsl(var(--hero-bg-c)) 0%, transparent 70%);
    }

    /* soften hero bottom so no hard “frame” edge */
    #amiquus-hero::after{
      content:"";
      position:absolute;
      left:0; right:0;
      bottom:-1px;
      height:140px;
      pointer-events:none;
      z-index: 2;
      background: linear-gradient(to bottom, transparent 0%, transparent 100%);
    }
    .dark #amiquus-hero::after{
      background:
        linear-gradient(to bottom,
          transparent 0%,
          hsl(var(--background) / 0.55) 55%,
          hsl(var(--background)) 100%);
    }


    .hero-stage {
      filter: drop-shadow(0 30px 70px rgb(0 0 0 / .22));
      perspective: 900px;

      /* FIX: force rounding and clipping for ALL children (no square flashes) */
      border-radius: 1.5rem;
      overflow: hidden;
      isolation: isolate;
    }
    .dark .hero-stage {
      filter: drop-shadow(0 30px 70px rgb(0 0 0 / .50));
    }

    .hero-stage-panel {
      background:
        radial-gradient(120% 100% at 20% 0%, var(--hero-stage-glass) 0%, transparent 55%),
        linear-gradient(180deg, var(--hero-stage-glass), var(--hero-stage-glass-2));
      border: 1px solid var(--hero-stage-border);
      backdrop-filter: blur(14px) saturate(1.1);
      box-shadow:
        inset 0 0 0 1px rgba(255,255,255,.20),
        inset 0 -30px 60px rgba(0,0,0,.04),
        0 22px 70px rgb(0 0 0 / .10);
    }
    .dark .hero-stage-panel {
      box-shadow:
        inset 0 0 0 1px rgba(255,255,255,.10),
        inset 0 -30px 60px rgba(0,0,0,.30),
        0 25px 80px rgb(0 0 0 / .45);
    }

    /* ---------- HERO CARDS ---------- */
    .hero-float-card,
    .hero-main-card {
      position: absolute;
      border-radius: 1.25rem;
      overflow: hidden;
      border: 1px solid var(--hero-card-border);
      box-shadow:
        0 18px 45px rgb(0 0 0 / 0.18),
        inset 0 0 0 1px rgba(255,255,255,.08);
      backdrop-filter: blur(12px) saturate(1.15);
      -webkit-backdrop-filter: blur(12px) saturate(1.15);

      background:
        radial-gradient(140% 120% at 0% 0%, var(--hero-card-glass) 0%, transparent 55%),
        linear-gradient(180deg, var(--hero-card-glass), var(--hero-card-glass-2));

      will-change: transform, opacity, filter;
      transform-style: preserve-3d;
      pointer-events: none;
    }

    .hero-float-card {
      width: clamp(190px, 20vw, 300px);
      opacity: var(--hero-float-opacity);
      filter: blur(var(--hero-float-blur)) saturate(.98);
    }

    .hero-main-card {
      position: relative;
      width: min(92%, 420px);
      animation: mainWiggle 1.3s ease-in-out infinite;
      pointer-events: auto;
    }

    @keyframes mainWiggle {
      0%,100% { transform: translateY(0) rotate(-0.6deg); }
      50%     { transform: translateY(-3px) rotate(0.6deg); }
    }

    .hero-card-img {
      height: 210px;
      background: hsl(var(--muted));
      display: grid;
      place-items: center;
      position: relative;
      border-top-left-radius: inherit;
      border-top-right-radius: inherit;
      overflow: hidden;
      z-index: 0;
    }

    .hero-card-img img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      position: relative;
      z-index: 1;
    }

    .hero-float-card .hero-card-img { height: 175px; }
    .hero-float-card .hero-meta { padding: 0.75rem 0.9rem; }

    .hero-meta {
      padding: 0.9rem 1rem;
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 0.5rem 0.75rem;
      align-items: center;
      background:
        linear-gradient(180deg, rgba(255,255,255,.45), transparent);
      border-bottom-left-radius: inherit;
      border-bottom-right-radius: inherit;
    }
    .dark .hero-meta {
      background: linear-gradient(180deg, rgba(255,255,255,.04), transparent);
    }

    .hero-brand {
      font-weight: 900;
      font-size: 1.05rem;
      color: hsl(var(--primary));
      line-height: 1.15;
      text-shadow: 0 2px 0 rgb(0 0 0 / .06);
    }

    .hero-model {
      font-weight: 700;
      font-size: 0.98rem;
      color: hsl(var(--foreground));
      opacity: .95;
    }

    .hero-price {
      font-weight: 900;
      font-size: 1.18rem;
      color: hsl(142 76% 36%);
      white-space: nowrap;
      text-shadow:
        0 6px 18px rgb(0 0 0 / .10),
        0 0 18px hsl(142 76% 36% / .40);
      letter-spacing: .2px;
    }
    .dark .hero-price {
      text-shadow:
        0 6px 18px rgb(0 0 0 / .25),
        0 0 18px hsl(142 76% 36% / .70);
    }

    .hero-sub {
      font-size: .8rem;
      color: hsl(var(--muted-foreground));
      margin-top: .1rem;
    }

    /* ---------- STAMP (CHANGE #3: refined JUST SOLD badge) ---------- */
    .hero-stamp {
      position: absolute;
      top: 14px;
      left: 50%;
      padding: .48rem 1.05rem;
      border-radius: 9999px;
      font-weight: 950;
      letter-spacing: .10em;
      text-transform: uppercase;
      color: #fff;

      background:
        radial-gradient(120% 140% at 100% 0%, rgb(255 255 255 / .20), transparent 55%),
        repeating-linear-gradient(
          -45deg,
          rgb(255 255 255 / .10) 0px,
          rgb(255 255 255 / .10) 2px,
          transparent 2px,
          transparent 8px
        ),
        linear-gradient(
          180deg,
          hsl(var(--destructive)) 0%,
          hsl(var(--destructive) / .9) 100%
        );

      border: 2px solid rgb(255 255 255 / .95);
      box-shadow:
        0 8px 22px rgb(0 0 0 / .45),
        inset 0 0 0 1px rgb(255 255 255 / .18),
        inset 0 -6px 12px rgb(0 0 0 / .18);

      transform: translateX(-50%) rotate(-9deg) scale(.94);
      opacity: 0;
      filter: blur(.2px) contrast(1.15);
      pointer-events: none;
      z-index: 50;

      text-shadow:
        0 2px 0 rgb(0 0 0 / .55),
        0 0 10px rgb(0 0 0 / .25);
      white-space: nowrap;
    }

    .hero-stamp::after{
      content:"";
      position:absolute;
      inset:-3px;
      border-radius: inherit;
      border: 1px dashed rgb(255 255 255 / .55);
      opacity:.55;
      pointer-events:none;
      mix-blend-mode: overlay;
    }

    .hero-main-card.is-stamping .hero-stamp {
      animation: stampIn 600ms cubic-bezier(.2,.9,.25,1.2) forwards;
    }

    @keyframes stampIn {
      0%   { opacity: 0; transform: translateX(-50%) rotate(-18deg) scale(.25); }
      70%  { opacity: 1; transform: translateX(-50%) rotate(-9deg) scale(1.12); }
      100% { opacity: 1; transform: translateX(-50%) rotate(-9deg) scale(1); filter:none; }
    }

    .hero-main-card.is-entering{
      opacity: 0;
      transform: translateY(14px) scale(0.985);
      filter: blur(1px);
    }

    .hero-main-card.is-ashing{
      opacity: 0;
      transform: translateY(60px) scale(0.9) rotateX(12deg);
      filter: blur(6px) grayscale(1);
      transition: transform 900ms ease, opacity 900ms ease, filter 900ms ease;
      pointer-events: none;
    }

    .ash{
      position: absolute;
      left: 8%;
      right: 8%;
      bottom: 10px;
      height: 18px;
      background: radial-gradient(closest-side, rgb(255 255 255 / .22), transparent 70%);
      filter: blur(8px);
      opacity: 0;
      animation: ashPoof 950ms ease forwards;
    }
    @keyframes ashPoof{
      0% { opacity: 0; transform: scale(.6) translateY(0); }
      25% { opacity: .7; transform: scale(1) translateY(-2px); }
      100% { opacity: 0; transform: scale(1.5) translateY(6px); }
    }

    /* ---------- MONEY LOSS (slower/longer) ---------- */
    .money-puff{
      position: absolute;
      transform: translate(-50%,-50%);
      font-weight: 1000;

      color: hsl(var(--money-red));
      text-shadow:
        0 10px 28px rgb(0 0 0 / .55),
        0 0 22px hsl(var(--money-red) / .90);

      pointer-events: none;
      opacity: 0;
      animation: moneyPuff 3200ms ease forwards;
      will-change: transform, opacity, filter;
    }

    @keyframes moneyPuff{
      0%   { opacity: 0; transform: translate(-50%,-50%) scale(.55) rotate(var(--rot)); filter: blur(0px); }
      8%   { opacity: 1; transform: translate(-50%,-90%) scale(1.35) rotate(var(--rot)); }

      60%  {
        opacity: 1;
        transform: translate(calc(-50% + var(--dx)*.6), calc(-50% - 175px))
          scale(1.12)
          rotate(calc(var(--rot) * 1.25));
      }

      100% {
        opacity: 0;
        transform:
          translate(calc(-50% + var(--dx)), calc(-50% - 280px))
          scale(.18)
          rotate(calc(var(--rot) * 1.7));
        filter: blur(8px) saturate(.55);
      }
    }

    /* ---------- FINAL OVERLAY (rounded + clipped) ---------- */
    .hero-final-overlay{
      position: absolute;
      inset: 0;
      display: grid;
      place-items: center;
      text-align: center;
      font-weight: 900;
      letter-spacing: .6px;

      background:
        radial-gradient(90% 80% at 50% 50%, rgb(0 0 0 / .10), rgb(0 0 0 / .52)),
        linear-gradient(180deg, hsl(var(--destructive) / .10), transparent);

      opacity: 0;
      transform: scale(0.98);
      pointer-events: none;
      backdrop-filter: blur(6px);

      /* FIX: never square */
      border-radius: 1.5rem;
    }

    .hero-final-overlay .glass{
      padding: clamp(1.15rem, 2vw, 1.75rem) clamp(1.3rem, 3vw, 2.4rem);
      border-radius: 1.35rem;

      background:
        linear-gradient(180deg, rgb(255 255 255 / .20), rgb(255 255 255 / .08));
      border: 1px solid rgb(255 255 255 / .45);
      box-shadow:
        0 18px 60px rgb(0 0 0 / .45),
        inset 0 0 0 1px rgb(255 255 255 / .12);
    }

    .hero-final-overlay.show { animation: finalOverlay 3000ms ease forwards; }

    /* CHANGE #2: line1 fully white */
    .hero-final-overlay .line1{
      font-size: clamp(1.9rem, 4vw, 2.85rem);
      text-transform: uppercase;
      color: hsl(var(--foreground));
      text-shadow: 0 10px 30px rgb(0 0 0 / .65);
    }
    .hero-final-overlay .line1 span{
      color: inherit;
      text-shadow: inherit;
    }

    /* CHANGE #2: line2 fully red */
    .hero-final-overlay .line2{
      margin-top: .55rem;
      font-size: clamp(1.4rem, 3.1vw, 2.2rem);
      color: hsl(var(--money-red));
      text-transform: uppercase;
      letter-spacing: .12em;
      text-shadow:
        0 10px 30px rgb(0 0 0 / .65),
        0 0 26px hsl(var(--money-red) / .85);
    }
    .hero-final-overlay .line2 span{
      color: inherit;
      text-shadow: inherit;
    }

    @keyframes finalOverlay{
      0% { opacity: 0; transform: scale(.98); }
      12% { opacity: 1; transform: scale(1); }
      88% { opacity: 1; transform: scale(1); }
      100% { opacity: 0; transform: scale(1.02); }
    }

    /* =========================================================
       PROBLEM / SOLUTION — light mode matches bg-background
       ========================================================= */
    #amiquus-probsol{
      background: hsl(var(--background));
      border-top: 1px solid hsl(var(--border)/.55);
      border-bottom: 1px solid hsl(var(--border)/.55);
    }

    .dark #amiquus-probsol{
      background:
        radial-gradient(60rem 20rem at 50% -20%, hsl(var(--primary)/.14), transparent 70%),
        linear-gradient(180deg, hsl(222 40% 8%) 0%, hsl(222 40% 6%) 100%);
      border-top: 1px solid hsl(var(--border)/.35);
      border-bottom: 1px solid hsl(var(--border)/.35);
    }

    #amiquus-probsol .probsol-bg{ opacity:.45; }

    .probsol-card{
      background:
        linear-gradient(180deg, hsl(var(--card)), hsl(var(--card)) 60%, hsl(var(--muted)/.30));
      border: 1px solid hsl(var(--border)/.8);
      box-shadow:
        0 12px 40px rgb(0 0 0 / .05),
        inset 0 0 0 1px rgb(255 255 255 / .62);
      backdrop-filter: blur(4px);
      transition: transform .35s ease, box-shadow .35s ease, border-color .35s ease;
    }
    .probsol-card:hover{
      transform: translateY(-4px);
      border-color: hsl(var(--primary)/.45);
      box-shadow:
        0 18px 60px rgb(0 0 0 / .08),
        inset 0 0 0 1px rgb(255 255 255 / .75);
    }

    .dark .probsol-card{
      background:
        radial-gradient(140% 120% at 0% 0%, rgb(255 255 255 / .06) 0%, transparent 55%),
        linear-gradient(180deg, rgb(14 18 30 / .92), rgb(10 14 25 / .92));
      border: 1px solid hsl(var(--border)/.45);
      box-shadow: 0 18px 60px rgb(0 0 0 / .35);
    }

    .probsol-card--bad{ border-color: hsl(var(--destructive)/.25); }
    .probsol-card--good{ border-color: hsl(142 76% 36% / .25); }

    .probsol-icon{
      box-shadow: inset 0 0 0 1px rgb(255 255 255 / .9), 0 8px 20px rgb(0 0 0 / .06);
    }
    .probsol-icon--bad{
      background: linear-gradient(180deg, hsl(var(--destructive)/.10), hsl(var(--destructive)/.05));
      color: hsl(var(--destructive));
    }
    .probsol-icon--good{
      background: linear-gradient(180deg, hsl(142 76% 36% / .12), hsl(142 76% 36% / .06));
      color: hsl(142 76% 36%);
    }

    .probsol-bad-accent{ color: hsl(var(--destructive)); }
    .probsol-good-accent{ color: hsl(142 76% 36%); }
    .probsol-good-accent-2{ color: hsl(var(--primary)); }

    .probsol-dot-bad{ background: hsl(var(--destructive)); }
    .probsol-dot-good{ background: hsl(142 76% 36%); }

    #amiquus-probsol .chip{
      display:inline-flex; align-items:center; justify-content:center;
      padding:.25rem .625rem; font-size:.75rem; border-radius:9999px;
      border:1px solid hsl(var(--chip) / .35);
      color: hsl(var(--chip));
      background: linear-gradient(180deg, hsl(var(--chip)/.10), hsl(var(--chip)/.04));
    }

    @media (prefers-reduced-motion:no-preference){
      #amiquus-probsol .will-animate{opacity:0;transform:translateY(12px);transition:opacity .6s ease, transform .6s ease}
      #amiquus-probsol .will-animate.in-view{opacity:1;transform:none}
      #amiquus-probsol [data-anim="fade-right"]{transform:translateX(-12px)}
      #amiquus-probsol [data-anim="fade-left"]{transform:translateX(12px)}
      #amiquus-probsol .in-view[data-anim="fade-right"],
      #amiquus-probsol .in-view[data-anim="fade-left"]{transform:none}

      .sand-top{animation:sandTop 2.2s infinite ease-in-out}
      .sand-bot{animation:sandBot 2.2s infinite ease-in-out}
      @keyframes sandTop{0%{opacity:1;transform:translateY(0)}50%{opacity:.2;transform:translateY(4px)}100%{opacity:1;transform:translateY(0)}}
      @keyframes sandBot{0%{opacity:.2;transform:translateY(-4px)}50%{opacity:1;transform:translateY(0)}100%{opacity:.2;transform:translateY(-4px)}}

      .ping-dot{animation:pingDot 1.6s ease-in-out infinite}
      @keyframes pingDot{0%,100%{opacity:.5;transform:scale(.9)}50%{opacity:1;transform:scale(1.15)}}
    }

    .cta-btn{
      color:white;
      background: linear-gradient(90deg, hsl(var(--primary)), hsl(142 76% 36%));
      background-size:200% 100%;
      animation:ctaGradient 5s linear infinite, ctaPulse 1.8s ease-in-out infinite;
      box-shadow: 0 8px 30px rgb(0 0 0 / .25);
    }
    @keyframes ctaGradient{0%{background-position:0% 50%}100%{background-position:100% 50%}}
    @keyframes ctaPulse{
      0%{box-shadow:0 0 0 0 hsl(var(--primary)/.35)}
      70%{box-shadow:0 0 0 14px hsl(var(--primary)/0)}
      100%{box-shadow:0 0 0 0 hsl(var(--primary)/0)}
    }

    /* FINAL OVERLAY */
    .hero-final-overlay .line1{
      font-size: clamp(1.9rem, 4vw, 2.85rem);
      text-transform: uppercase;
      color: #fff;
      text-shadow: 0 10px 30px rgb(0 0 0 / .65);
    }
    .hero-final-overlay .line1 span{
      color: inherit;
      text-shadow: inherit;
    }
  </style>

  <script>
    // One-time reveal on scroll (scoped to prob/sol)
    (function(){
      const root = document.getElementById('amiquus-probsol');
      if(!root) return;
      const els = root.querySelectorAll('.will-animate');
      if(!('IntersectionObserver' in window)){ els.forEach(el=> el.classList.add('in-view')); return; }
      const io=new IntersectionObserver((entries)=>{
        entries.forEach(e=>{ if(e.isIntersecting){ e.target.classList.add('in-view'); io.unobserve(e.target); }});
      },{threshold:.15,rootMargin:'0px 0px -10% 0px'});
      els.forEach(el=> io.observe(el));
    })();

    // ===== HERO FOREGROUND + GLOBAL FLOAT BACKGROUND =====
    (function(){
      const hero = document.getElementById('amiquus-hero');
      const floatLayer = document.getElementById('hero-float-layer');
      const mainWrap = document.getElementById('hero-main-wrap');
      const finalOverlay = document.getElementById('hero-final-overlay');
      if(!hero || !floatLayer || !mainWrap || !finalOverlay) return;

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const cars = [
        { brand:"BMW",      model:"320d Touring",  price:"€18,900", img:"/homepage/demo-cars/bmw_320d_touring_hero_image.webp" },
        { brand:"Audi",     model:"A4 Avant",      price:"€21,450", img:"/homepage/demo-cars/audi_a4_avant_hero_image.webp" },
        { brand:"Mercedes", model:"C220d AMG",     price:"€23,100", img:"/homepage/demo-cars/mercedes_c220d_amg_hero_image.webp" },
        { brand:"VW",       model:"Golf GTI",      price:"€17,990", img:"/homepage/demo-cars/vw_golf_gti_hero_image.webp" },
        { brand:"Škoda",    model:"Octavia RS",    price:"€19,800", img:"/homepage/demo-cars/skoda_octavia_rs_hero_image.webp" },
        { brand:"Tesla",    model:"Model 3 LR",    price:"€29,900", img:"/homepage/demo-cars/tesla_model_3_lr_hero_image.webp" },

        // background pool
        { brand:"Volvo",    model:"V60 D4",        price:"€22,750", img:"/homepage/demo-cars/volvo_v60_d4_hero_image.webp" },
        { brand:"Peugeot",  model:"3008 GT",       price:"€16,700", img:"/homepage/demo-cars/peugeot_3008_gt_hero_image.webp" },
        { brand:"Renault",  model:"Megane RS",     price:"€15,400", img:"/homepage/demo-cars/renault_megane_rs_hero_image.webp" },
        { brand:"Toyota",   model:"RAV4 Hybrid",   price:"€24,300", img:"/homepage/demo-cars/toyota_rav4_hybrid_hero_image.webp" },
        { brand:"Ford",     model:"Focus ST",      price:"€14,980", img:"/homepage/demo-cars/ford_focus_st_hero_image.webp" },
        { brand:"Kia",      model:"Ceed SW",       price:"€13,200", img:"/homepage/demo-cars/kia_ceed_sw_hero_image.webp" },
      ];

      const foreground = cars.slice(0, 6);
      const backgroundPool = cars.slice(6);

      function createCard(car, cls){
        const card = document.createElement('article');
        card.className = cls;
        card.setAttribute('role','listitem');
        card.setAttribute('aria-label', `${car.brand} ${car.model} at ${car.price}`);

        card.innerHTML = `
          <div class="hero-card-img">
            <img
              src="${car.img}"
              alt="${car.brand} ${car.model}"
              loading="eager"
              decoding="async"
              onerror="this.style.display='none'; this.parentElement.innerHTML='<div style=&quot;color: hsl(var(--muted-foreground)); font-weight:700; font-size:0.95rem;&quot;>Car photo</div>';"
            />
          </div>

          <div class="hero-stamp" aria-hidden="true">JUST SOLD</div>

          <div class="hero-meta">
            <div>
              <div class="hero-brand">${car.brand}</div>
              <div class="hero-model">${car.model}</div>
              <div class="hero-sub">New listing</div>
            </div>
            <div class="hero-price">${car.price}</div>
          </div>
        `;
        return card;
      }

      // ---------- FLOAT BACKGROUND ENGINE ----------
      let floatNodes = [];
      let rafId = null;
      let lastT = 0;

      function clearFloat(){
        if(rafId) cancelAnimationFrame(rafId);
        rafId = null;
        floatLayer.innerHTML = '';
        floatNodes = [];
        lastT = 0;
      }

      function layoutFloat(){
        clearFloat();

        const rect = hero.getBoundingClientRect();
        const W = rect.width;
        const H = rect.height;

        const count = Math.max(14, Math.min(22, Math.floor(W / 90)));
        const pad = Math.min(70, W * 0.06);
        const minDist = Math.min(220, W * 0.18);

        const placed = [];

        function pickSpot(){
          for(let tries=0; tries<120; tries++){
            const x = pad + Math.random() * (W - pad*2);
            const y = pad + Math.random() * (H - pad*2);
            let ok = true;
            for(const p of placed){
              const d = Math.hypot(x - p.x, y - p.y);
              if(d < minDist){ ok = false; break; }
            }
            if(ok){ placed.push({x,y}); return {x,y}; }
          }
          const x = pad + Math.random() * (W - pad*2);
          const y = pad + Math.random() * (H - pad*2);
          placed.push({x,y});
          return {x,y};
        }

        for(let i=0;i<count;i++){
          const car = backgroundPool[i % backgroundPool.length];
          const el = createCard(car, 'hero-float-card');

          const {x,y} = pickSpot();

          const scale = 0.6 + Math.random()*0.75;
          const z = -40 - Math.random()*420;
          const rot = (Math.random()*28 - 14);
          const rx = (Math.random()*10 - 5);
          const ry = (Math.random()*10 - 5);

          const speed = 0.012 + Math.random()*0.020;
          const ang = Math.random()*Math.PI*2;
          const vx = Math.cos(ang)*speed*(0.8 + Math.random()*0.7);
          const vy = Math.sin(ang)*speed*(0.8 + Math.random()*0.7);

          const rotV = (Math.random()*0.008 - 0.004);

          el.style.transform =
            `translate3d(${x}px, ${y}px, ${z}px) translate(-50%,-50%) rotateX(${rx}deg) rotateY(${ry}deg) rotate(${rot}deg) scale(${scale})`;

          floatLayer.appendChild(el);

          floatNodes.push({ el, x, y, vx, vy, rot, rotV, scale, z, rx, ry });
        }

        if(!reduceMotion){
          rafId = requestAnimationFrame(tick);
        }
      }

      function tick(t){
        if(!lastT) lastT = t;
        const dt = t - lastT;
        lastT = t;

        const rect = hero.getBoundingClientRect();
        const W = rect.width;
        const H = rect.height;

        for(const n of floatNodes){
          n.x += n.vx * dt;
          n.y += n.vy * dt;
          n.rot += n.rotV * dt;

          if(n.x < -80) n.x = W + 80;
          if(n.x > W + 80) n.x = -80;
          if(n.y < -80) n.y = H + 80;
          if(n.y > H + 80) n.y = -80;

          n.el.style.transform =
            `translate3d(${n.x}px, ${n.y}px, ${n.z}px) translate(-50%,-50%) rotateX(${n.rx}deg) rotateY(${n.ry}deg) rotate(${n.rot}deg) scale(${n.scale})`;
        }

        rafId = requestAnimationFrame(tick);
      }

      const ro = new ResizeObserver(() => layoutFloat());
      ro.observe(hero);

      // ---------- FOREGROUND CYCLE ----------
      function spawnMoneyPuffs(targetCard){
        const symbols = ['€', '$', '£'];
        const count = 14;
        for(let i=0;i<count;i++){
          const puff = document.createElement('div');
          puff.className = 'money-puff';

          const sym = symbols[Math.floor(Math.random()*symbols.length)];
          puff.textContent = `-${sym}`;

          const dx = (Math.random()*240 - 120).toFixed(0) + 'px';
          const rot = (Math.random()*40 - 20).toFixed(0) + 'deg';
          const size = (1.35 + Math.random()*1.25);

          puff.style.setProperty('--dx', dx);
          puff.style.setProperty('--rot', rot);
          puff.style.animationDelay = (i*70) + 'ms';
          puff.style.left = (38 + Math.random()*24) + '%';
          puff.style.top = (82 + Math.random()*5) + '%';
          puff.style.fontSize = (1.35*size).toFixed(2) + 'rem';

          targetCard.appendChild(puff);
          puff.addEventListener('animationend', ()=> puff.remove());
        }
      }

      function spawnAsh(target){
        const a = document.createElement('div');
        a.className = 'ash';
        target.appendChild(a);
        a.addEventListener('animationend', ()=> a.remove());
      }

      function applyStamp(card){
        const stamp = card.querySelector('.hero-stamp');
        if(!stamp) return;

        card.classList.remove('is-stamping');
        stamp.textContent = "JUST SOLD";
        void stamp.offsetWidth;
        card.classList.add('is-stamping');
      }

      async function showFinalOverlay(){
        finalOverlay.innerHTML = `
          <div class="glass">
            <div class="line1">Missed <span>opportunity</span></div>
            <div class="line2">Missed <span>profit</span></div>
          </div>
        `;
        finalOverlay.classList.add('show');
        await new Promise(r => setTimeout(r, 3000));
        finalOverlay.classList.remove('show');
      }

      let idx = 0;

      async function cycle(){
        layoutFloat();

        if(reduceMotion){
          mainWrap.innerHTML = '';
          mainWrap.appendChild(createCard(foreground[0], 'hero-main-card'));
          return;
        }

        while(true){
          mainWrap.innerHTML = '';
          const car = foreground[idx];
          const card = createCard(car, 'hero-main-card is-entering');
          mainWrap.appendChild(card);

          requestAnimationFrame(() => card.classList.remove('is-entering'));
          await new Promise(r => setTimeout(r, 1200));

          applyStamp(card);
          await new Promise(r => setTimeout(r, 850));

          spawnMoneyPuffs(card);
          await new Promise(r => setTimeout(r, 2200));

          spawnAsh(card);
          card.classList.add('is-ashing');
          await new Promise(r => setTimeout(r, 950));

          idx++;
          if(idx >= foreground.length){
            idx = 0;
            await showFinalOverlay();
            await new Promise(r => setTimeout(r, 550));
          } else {
            await new Promise(r => setTimeout(r, 260));
          }
        }
      }

      cycle();
    })();
  </script>


---
// src/pages/si/index.astro

import BaseLayout from '../../layouts/BaseLayout.astro';

// Page-specific metadata
const title = "Amiquus - Automated Car Listing Alerts";
const description = "Get real-time notifications for new car listings that match your criteria. Monitor multiple platforms automatically with instant Telegram alerts.";

// Props for BaseLayout - simplified to match working pattern
const languageIso = "en";
const countryCode = "US";
const contentOrientation = "ltr";
const languageLinksMap = { 'en': '/en', 'de': '/de' };
---

<BaseLayout
  languageIso={languageIso}
  countryCode={countryCode}
  contentOrientation={contentOrientation}
  title={title}
  description={description}
  languageLinksMap={languageLinksMap}
>
  <!-- Hero Section -->
  <section class="relative overflow-hidden bg-background py-20 sm:py-32">
    <div class="absolute inset-0 bg-gradient-to-br from-muted via-background to-background -z-10"></div>

    <div class="max-w-screen-xl mx-auto px-4">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <!-- Left copy -->
        <div class="text-center lg:text-start animate-on-scroll">
          <h1 class="text-4xl lg:text-5xl font-bold leading-tight text-foreground mb-6">
            Never Miss Your <span class="text-primary">Perfect Car Deal</span> Again
          </h1>

          <p class="text-lg text-muted-foreground mb-8 max-w-xl mx-auto lg:mx-0">
            Amiquus monitors multiple car listing platforms 24/7 and sends instant Telegram notifications the moment a matching car appears — so you act first, not last.
          </p>

          <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
            <a
              href="#pricing"
              class="inline-flex items-center justify-center px-6 py-3 rounded-lg font-semibold bg-primary text-primary-foreground shadow-lg hover:opacity-90 transition-transform hover:-translate-y-1"
              aria-label="Go to pricing"
            >
              Pricing
            </a>
            <a
              href="/si/setup-alerts"
              class="inline-flex items-center justify-center px-6 py-3 rounded-lg font-semibold bg-transparent border-2 border-border text-foreground hover:bg-muted transition-colors"
              aria-label="Go to setup alerts"
            >
              Get Alerts
            </a>
          </div>
        </div>

        <!-- Right animation -->
        <div class="relative animate-on-scroll" data-delay="100" aria-label="Animated missed opportunities preview">
          <div class="relative h-[420px] sm:h-[480px] lg:h-[540px] w-full">
            <!-- Subtle stage background -->
            <div class="absolute inset-0 rounded-2xl bg-card/60 border border-border shadow-2xl shadow-primary/5"></div>

            <!-- Card stack -->
            <div id="hero-card-stack" class="absolute inset-0 p-5 sm:p-6">
              <!-- cards injected by script -->
            </div>

            <!-- gradient fade at bottom for depth -->
            <div aria-hidden="true" class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-background to-transparent rounded-b-2xl"></div>
          </div>

          <!-- SR-only static description -->
          <p class="sr-only">
            An animated stack of car listing cards disappears one by one with a drifting euro icon and overlay text saying missed opportunity and missed profit.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- "PROBLEM / SOLUTION" SECTION — Fixed dark swap via Tailwind dark:[background:...] -->
  <section id="amiquus-probsol" class="relative py-16 sm:py-24 overflow-hidden" aria-labelledby="probsol-title">
    <!-- Ambient gradient backdrop (theme-driven) -->
    <div aria-hidden="true" class="absolute inset-0 pointer-events-none">
      <div class="absolute -top-40 left-1/2 h-[48rem] w-[48rem] -translate-x-1/2 rounded-full blur-3xl opacity-45"
           style="background:radial-gradient(35% 35% at 50% 50%, rgb(var(--amq-primary) / .28) 0%, transparent 60%)"></div>
      <div class="absolute bottom-[-30%] right-[-10%] h-[36rem] w-[36%] rounded-full blur-3xl opacity-35 dark:opacity-40"
           style="background:radial-gradient(40% 40% at 50% 50%, rgb(var(--amq-success) / .25) 0%, transparent 60%)"></div>
    </div>

    <div class="max-w-screen-xl mx-auto px-4">
      <!-- Header (forced-dark look preserved) -->
      <div class="force-dark text-center max-w-3xl mx-auto will-animate" data-anim="fade-up">
        <h2 id="probsol-title" class="text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight">
          Find the car first.
          <span class="bg-clip-text text-transparent"
                style="background-image:linear-gradient(90deg, rgb(var(--amq-primary)), rgb(var(--amq-success)));">
            Every time.
          </span>
        </h2>
        <p class="mt-3 text-base md:text-lg lg:text-xl text-[rgb(var(--amq-muted))]" aria-live="polite">
          Amiquus watches listings 24/7 and pings you instantly.
        </p>
      </div>

      <!-- Cards -->
      <div class="mt-10 grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8" role="list">
        <!-- BAD / OLD WAY -->
        <article role="listitem" aria-label="Old way: manual refreshing" data-tone="danger"
          class="group relative rounded-2xl p-6 md:pr-28 lg:pr-36 shadow-sm will-animate card is-theme
                 ring-1 ring-amq-danger/20
                 bg-[linear-gradient(180deg,rgba(var(--amq-danger-tint-top)/.96),rgba(var(--amq-danger-tint-bot)/.96))]
                 text-amq-text
                 dark:[background:linear-gradient(to_bottom,_rgb(var(--amq-surface)),_rgb(var(--amq-elev)))]
                 dark:border dark:border-[rgb(var(--amq-danger)/.35)] dark:shadow-none dark:text-[rgb(var(--amq-text))]"
          data-anim="fade-right">
          <!-- side icon -->
          <div class="hidden sm:block absolute top-1/2 -translate-y-1/2 right-10 md:right-12 lg:right-16 opacity-90
                      text-amq-danger" aria-hidden="true">
            <!-- Lucide: banknote-x -->
            <svg class="themed-svg h-16 w-16 md:h-20 md:w-20 icon-float" xmlns="http://www.w3.org/2000/svg"
                 viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M13 18H4a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5"/>
              <path d="m17 17 5 5"/>
              <path d="M18 12h.01"/>
              <path d="m22 17-5 5"/>
              <path d="M6 12h.01"/>
              <circle cx="12" cy="12" r="2"/>
            </svg>
          </div>

          <header class="flex items-center gap-3" aria-label="Manual refreshing icon and title">
            <div class="h-12 w-12 md:h-14 md:w-14 grid place-items-center rounded-xl
                        bg-rose-100 text-amq-danger
                        dark:[background:linear-gradient(135deg,_rgb(var(--amq-danger)/.22),_rgb(var(--amq-danger)/.08))]">
              <!-- Hourglass -->
              <svg viewBox="0 0 24 24" class="h-6 w-6 md:h-7 md:w-7" role="img" aria-label="Hourglass">
                <g>
                  <path fill="currentColor" d="M6 3h12v2a5 5 0 0 1-2.1 4.1L14 10l1.9.9A5 5 0 0 1 18 15v2H6v-2a5 5 0 0 1 2.1-4.1L10 10 8.1 9.1A5 5 0 0 1 6 5V3Z"/>
                  <circle cx="12" cy="10" r="1.4" fill="currentColor" class="sand-top"></circle>
                  <circle cx="12" cy="14" r="1.4" fill="currentColor" class="sand-bot"></circle>
                </g>
              </svg>
            </div>
            <h3 class="text-lg md:text-xl lg:text-2xl font-semibold text-slate-900 dark:text-[rgb(var(--amq-danger))]">
              Manual refreshing
            </h3>
          </header>

          <p class="mt-3 text-sm md:text-base lg:text-[17px] leading-relaxed text-slate-800 dark:text-[rgb(var(--amq-muted))]">
            You refresh, <span class="text-rose-700 font-semibold dark:text-[rgb(var(--amq-danger))]">you miss</span>, you repeat.
          </p>

          <!-- chips -->
          <div class="mt-4 flex flex-wrap gap-2" aria-label="Pain points">
            <span class="chip md:text-[12px]" style="--chip: var(--amq-danger)">Time sink</span>
            <span class="chip md:text-[12px]" style="--chip: var(--amq-danger)">Missed deals</span>
            <span class="chip md:text-[12px]" style="--chip: var(--amq-danger)">Stress</span>
          </div>

          <!-- hover glow (dark only visual) -->
          <div aria-hidden="true"
               class="absolute inset-0 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-500
                      dark:[background:radial-gradient(24rem_12rem_at_0%_0%,_rgb(var(--amq-danger)/.14),_transparent_60%)]">
          </div>
        </article>

        <!-- GOOD / AMIQUUS WAY -->
        <article role="listitem" aria-label="Amiquus way: automated alerts" data-tone="success"
          class="group relative rounded-2xl p-6 md:pr-28 lg:pr-36 shadow-sm will-animate card is-theme
                 ring-1 ring-amq-success/20
                 bg-[linear-gradient(180deg,rgba(var(--amq-success-tint-top)/.97),rgba(var(--amq-success-tint-bot)/.97))]
                 text-amq-text
                 dark:[background:linear-gradient(to_bottom,_rgb(var(--amq-surface)),_rgb(var(--amq-elev)))]
                 dark:border dark:border-[rgb(var(--amq-success)/.35)] dark:shadow-none dark:text-[rgb(var(--amq-text))]"
          data-anim="fade-left">
          <!-- side icon -->
          <div class="hidden sm:block absolute top-1/2 -translate-y-1/2 right-10 md:right-12 lg:right-16 opacity-95
                      text-amq-success" aria-hidden="true">
            <!-- Lucide: banknote-arrow-up -->
            <svg class="themed-svg h-16 w-16 md:h-20 md:w-20 icon-wobble" xmlns="http://www.w3.org/2000/svg"
                 viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 18H4a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5"/>
              <path d="M18 12h.01"/>
              <path d="M19 22v-6"/>
              <path d="m22 19-3-3-3 3"/>
              <path d="M6 12h.01"/>
              <circle cx="12" cy="12" r="2"/>
            </svg>
          </div>

          <header class="flex items-center gap-3" aria-label="Auto alerts icon and title">
            <div class="h-12 w-12 md:h-14 md:w-14 grid place-items-center rounded-xl
                        bg-emerald-100 text-emerald-700
                        dark:[background:linear-gradient(135deg,_rgb(var(--amq-success)/.22),_rgb(var(--amq-success)/.08))]">
              <!-- Bell -->
              <svg viewBox="0 0 24 24" class="h-6 w-6 md:h-7 md:w-7" role="img" aria-label="Notification bell">
                <path fill="currentColor" d="M12 22a2 2 0 0 0 2-2h-4a2 2 0 0 0 2 2Zm7-6V11a7 7 0 1 0-14 0v5l-2 2v1h18v-1l-2-2Z"/>
                <circle class="ping-dot" cx="18" cy="6" r="2" fill="currentColor"/>
              </svg>
            </div>
            <h3 class="text-lg md:text-xl lg:text-2xl font-semibold text-slate-900 dark:text-[rgb(var(--amq-success))]">
              Automated alerts
            </h3>
          </header>

          <p class="mt-3 text-sm md:text-base lg:text-[17px] leading-relaxed text-slate-800 dark:text-[rgb(var(--amq-muted))]">
            <span class="font-semibold text-emerald-700 dark:text-[rgb(var(--amq-success))]">We scan.</span>
            <span class="text-sky-500 dark:text-sky-400 font-semibold">Telegram pings you</span>. You act first.
          </p>

          <!-- chips -->
          <div class="mt-4 flex flex-wrap gap-2" aria-label="Benefits">
            <span class="chip md:text-[12px]" style="--chip: var(--amq-success)">24/7 scan</span>
            <span class="chip md:text-[12px]" style="--chip: var(--amq-success)">Instant ping</span>
            <span class="chip md:text-[12px]" style="--chip: var(--amq-success)">Full coverage</span>
          </div>

          <!-- CTA -->
          <div class="mt-5 flex items-center justify-between">
            <div class="flex items-center gap-2 text-xs md:text-sm text-slate-700 dark:text-[rgb(var(--amq-muted))]" aria-label="Live monitoring indicator">
              <span class="h-2 w-2 rounded-full bg-amq-success" aria-hidden="true"></span>
              <span>Live monitoring</span>
            </div>
            <a href="#order"
               aria-label="Get ahead of others. Start in 60 seconds."
               class="cta-btn inline-flex items-center justify-center gap-2 rounded-full px-4 py-2 text-sm md:text-[15px] font-semibold
                      focus:outline-none focus-visible:ring-2
                      lg:px-3.5 lg:py-1.5 lg:text-sm lg:scale-[0.97]"
               style="color:white; background:linear-gradient(90deg, rgb(var(--amq-primary)), rgb(var(--amq-success)));
                      background-size:200% 100%; animation:ctaGradient 5s linear infinite, ctaPulse 1.8s ease-in-out infinite;">
              <span class="whitespace-nowrap">Get ahead of others</span>
              <svg viewBox="0 0 24 24" class="h-4 w-4 md:h-5 md:w-5" role="img" aria-label="Arrow">
                <path fill="currentColor" d="M13 5l7 7-7 7v-4H4v-6h9V5z"/>
              </svg>
            </a>
          </div>

          <!-- hover glow (dark only visual) -->
          <div aria-hidden="true"
               class="absolute inset-0 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-500
                      dark:[background:radial-gradient(24rem_12rem_at_100%_0%,_rgb(var(--amq-success)/.14),_transparent_60%)]">
          </div>
        </article>
      </div>

      <!-- Proof row -->
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4 will-animate" data-anim="fade-up" aria-label="Trust indicators">
        <div class="force-dark flex items-center gap-2 text-xs md:text-sm text-[rgb(var(--amq-muted))]">
          <span class="i-badge" aria-hidden="true"></span>
          <span>Checks listings every ~15s on supported sites</span>
        </div>
        <div class="hidden sm:block h-4 w-px sep" aria-hidden="true"></div>
        <div class="force-dark flex items-center gap-2 text-xs md:text-sm text-[rgb(var(--amq-muted))]">
          <span class="i-shield" aria-hidden="true"></span>
          <span>No spam. Cancel anytime.</span>
        </div>
      </div>
    </div>
  </section>

  <style>
    /* Force-dark pack (header visual island) */
    .force-dark{
      --c-primary: var(--amq-primary);
      --c-success: var(--amq-success);
      --c-danger:  var(--amq-danger);
      --c-surface: var(--amq-surface);
      --c-elev:    var(--amq-elev);
      --c-text:    var(--amq-text);
      --c-muted:   var(--amq-muted);
      --c-border:  var(--amq-border);
      color-scheme: dark;
      color: rgb(var(--c-text));
    }
    .force-dark .text-muted{ color: rgb(var(--c-muted)); }

    /* Chips (variable-aware) */
    #amiquus-probsol .chip{
      display:inline-flex; align-items:center; justify-content:center;
      padding:.25rem .625rem; font-size:.75rem; border-radius:9999px;
      border:1px solid rgb(var(--chip) / .35); color: rgb(var(--chip) / .95);
      background: linear-gradient(180deg, rgb(var(--chip)/.12), rgb(var(--chip)/.05));
    }
    .dark #amiquus-probsol .chip{
      border-color: rgb(var(--chip)/.35) !important;
      color: rgb(var(--chip)/.9) !important;
      background: linear-gradient(180deg, rgb(var(--chip)/.10), rgb(var(--chip)/.04)) !important;
    }

    /* Inline SVGs follow currentColor */
    .themed-svg *[fill]{ fill: currentColor !important; }
    .themed-svg *[stroke]{ stroke: currentColor !important; }

    /* Proof row separator */
    #amiquus-probsol .sep { background: currentColor; opacity:.22; }

    /* Animations (unchanged) */
    @media (prefers-reduced-motion:no-preference){
      #amiquus-probsol .will-animate{opacity:0;transform:translateY(12px);transition:opacity .6s ease, transform .6s ease}
      #amiquus-probsol .will-animate.in-view{opacity:1;transform:none}
      #amiquus-probsol [data-anim="fade-right"]{transform:translateX(-12px)}
      #amiquus-probsol [data-anim="fade-left"]{transform:translateX(12px)}
      #amiquus-probsol .in-view[data-anim="fade-right"],#amiquus-probsol .in-view[data-anim="fade-left"]{transform:none}

      .sand-top{animation:sandTop 2.2s infinite ease-in-out}
      .sand-bot{animation:sandBot 2.2s infinite ease-in-out}
      @keyframes sandTop{0%{opacity:1;transform:translateY(0)}50%{opacity:.2;transform:translateY(4px)}100%{opacity:1;transform:translateY(0)}}
      @keyframes sandBot{0%{opacity:.2;transform:translateY(-4px)}50%{opacity:1;transform:translateY(0)}100%{opacity:.2;transform:translateY(-4px)}}

      .icon-float{animation:iconFloat 3s ease-in-out infinite}
      @keyframes iconFloat{0%,100%{transform:translateY(-4px)}50%{transform:translateY(4px)}}
      .icon-wobble{animation:iconWobble .8s ease-in-out infinite}
      @keyframes iconWobble{0%,100%{transform:rotate(-2deg)}50%{transform:rotate(2deg)}}

      @keyframes ctaGradient{0%{background-position:0% 50%}100%{background-position:100% 50%}}
      @keyframes ctaPulse{
        0%{box-shadow:0 0 0 0 rgba(59,130,246,.35)}
        70%{box-shadow:0 0 0 12px rgba(59,130,246,0)}
        100%{box-shadow:0 0 0 0 rgba(59,130,246,0)}
      }
      @keyframes ctaPulseDark{
        0%{box-shadow:0 0 0 0 rgb(var(--amq-primary)/.55)}
        70%{box-shadow:0 0 0 14px rgb(var(--amq-primary)/0)}
        100%{box-shadow:0 0 0 0 rgb(var(--amq-primary)/0)}
      }
    }

    /* Dark-mode specific button pulse */
    .dark #amiquus-probsol .cta-btn{
      animation: ctaGradient 5s linear infinite, ctaPulseDark 1.8s ease-in-out infinite !important;
    }

    /* ===== HERO CARDS ANIMATION PACK (scoped) ===== */
    #hero-card-stack { perspective: 1200px; }

    .hero-card {
      position: absolute;
      left: 0; right: 0;
      border-radius: 1rem;
      overflow: hidden;
      background: rgb(var(--card));
      border: 1px solid rgb(var(--border));
      box-shadow:
        0 12px 30px rgb(0 0 0 / 0.08),
        0 2px 8px rgb(0 0 0 / 0.03);
      transform-origin: center;
      transition: transform 700ms ease, opacity 700ms ease, filter 700ms ease;
      will-change: transform, opacity;
    }

    .hero-card .img-wrap {
      height: 8.5rem;
      background: rgb(var(--muted));
      display: grid;
      place-items: center;
    }
    .hero-card img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .hero-card .meta {
      padding: 0.75rem 0.9rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
    }

    .hero-card .title {
      font-weight: 700;
      font-size: 0.95rem;
      color: rgb(var(--foreground));
      line-height: 1.2;
    }

    .hero-card .price {
      font-weight: 800;
      color: rgb(var(--amq-success));
      font-size: 1rem;
      white-space: nowrap;
    }

    .hero-card .badge {
      font-size: 0.75rem;
      color: rgb(var(--muted-foreground));
      margin-top: 0.15rem;
    }

    .hero-card.is-exiting {
      opacity: 0;
      transform: translateY(18px) scale(0.98) rotateX(6deg);
      filter: blur(1px);
      pointer-events: none;
    }

    .money-puff {
      position: absolute;
      top: 50%;
      right: -8px;
      transform: translateY(-50%);
      font-weight: 800;
      color: rgb(var(--amq-primary));
      text-shadow: 0 4px 18px rgb(0 0 0 / .15);
      animation: moneyPuff 900ms ease forwards;
      pointer-events: none;
      opacity: 0;
    }
    @keyframes moneyPuff {
      0%   { opacity: 0; transform: translate(0, -50%) scale(.7); }
      15%  { opacity: 1; transform: translate(0, -70%) scale(1); }
      100% { opacity: 0; transform: translate(18px, -120%) scale(1.1); }
    }

    .overlay-text {
      position: absolute;
      inset: 0;
      display: grid;
      place-items: center;
      background: rgb(0 0 0 / 0.35);
      color: white;
      font-weight: 800;
      letter-spacing: .2px;
      text-transform: uppercase;
      text-align: center;
      padding: 1rem;
      animation: overlayPop 1100ms ease forwards;
      opacity: 0;
    }
    .overlay-text span {
      display: block;
      font-size: 1.05rem;
    }
    .overlay-text em {
      display: block;
      font-style: normal;
      font-size: 0.9rem;
      opacity: .9;
      margin-top: 0.25rem;
    }
    @keyframes overlayPop {
      0%   { opacity: 0; transform: scale(.98); }
      18%  { opacity: 1; transform: scale(1); }
      70%  { opacity: 1; transform: scale(1); }
      100% { opacity: 0; transform: scale(1.02); }
    }
  </style>

  <script>
    // One-time reveal on scroll (scoped to prob/sol)
    (function(){
      const root = document.getElementById('amiquus-probsol');
      if(!root) return;
      const els = root.querySelectorAll('.will-animate');
      if(!('IntersectionObserver' in window)){ els.forEach(el=> el.classList.add('in-view')); return; }
      const io=new IntersectionObserver((entries)=>{
        entries.forEach(e=>{ if(e.isIntersecting){ e.target.classList.add('in-view'); io.unobserve(e.target); }});
      },{threshold:.15,rootMargin:'0px 0px -10% 0px'});
      els.forEach(el=> io.observe(el));
    })();

    // ===== HERO CARD STACK ANIMATION =====
    (function(){
      const stack = document.getElementById('hero-card-stack');
      if(!stack) return;

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const cars = [
        { brand:"BMW", model:"320d Touring", price:"€18,900", img:"/homepage/demo-cars/car-01.webp" },
        { brand:"Audi", model:"A4 Avant", price:"€21,450", img:"/homepage/demo-cars/car-02.webp" },
        { brand:"Mercedes", model:"C220d", price:"€23,100", img:"/homepage/demo-cars/car-03.webp" },
        { brand:"VW", model:"Golf GTI", price:"€17,990", img:"/homepage/demo-cars/car-04.webp" },
        { brand:"Škoda", model:"Octavia RS", price:"€19,800", img:"/homepage/demo-cars/car-05.webp" },
        { brand:"Tesla", model:"Model 3 LR", price:"€29,900", img:"/homepage/demo-cars/car-06.webp" },
        { brand:"Volvo", model:"V60 D4", price:"€22,750", img:"/homepage/demo-cars/car-07.webp" },
        { brand:"Peugeot", model:"3008 GT", price:"€16,700", img:"/homepage/demo-cars/car-08.webp" },
        { brand:"Renault", model:"Megane RS", price:"€15,400", img:"/homepage/demo-cars/car-09.webp" },
        { brand:"Toyota", model:"RAV4 Hybrid", price:"€24,300", img:"/homepage/demo-cars/car-10.webp" },
        { brand:"Ford", model:"Focus ST", price:"€14,980", img:"/homepage/demo-cars/car-11.webp" },
        { brand:"Kia", model:"Ceed SW", price:"€13,200", img:"/homepage/demo-cars/car-12.webp" },
        { brand:"Hyundai", model:"i30 N", price:"€18,600", img:"/homepage/demo-cars/car-13.webp" },
        { brand:"Honda", model:"Civic Sport", price:"€12,900", img:"/homepage/demo-cars/car-14.webp" },
        { brand:"Mazda", model:"CX-5 Skyactiv", price:"€20,250", img:"/homepage/demo-cars/car-15.webp" },
        { brand:"Seat", model:"Leon FR", price:"€11,600", img:"/homepage/demo-cars/car-16.webp" },
        { brand:"Opel", model:"Insignia Grand", price:"€10,990", img:"/homepage/demo-cars/car-17.webp" },
        { brand:"Nissan", model:"Qashqai Tekna", price:"€15,900", img:"/homepage/demo-cars/car-18.webp" },
        { brand:"Mini", model:"Cooper S", price:"€16,300", img:"/homepage/demo-cars/car-19.webp" },
        { brand:"Porsche", model:"Cayman", price:"€39,900", img:"/homepage/demo-cars/car-20.webp" },
      ];

      function createCard(car, idx){
        const card = document.createElement('article');
        card.className = 'hero-card';
        card.setAttribute('role','listitem');
        card.setAttribute('aria-label', `${car.brand} ${car.model} at ${car.price}`);

        // stack depth
        const z = cars.length - idx;
        const y = idx * 6;
        const s = 1 - idx * 0.008;
        const r = (idx % 2 ? -0.4 : 0.4) * idx;

        card.style.zIndex = String(z);
        card.style.transform = `translateY(${y}px) scale(${s}) rotate(${r}deg)`;
        card.style.opacity = String(1 - idx * 0.02);

        card.innerHTML = `
          <div class="img-wrap">
            <img
              src="${car.img}"
              alt="${car.brand} ${car.model}"
              loading="lazy"
              decoding="async"
              onerror="this.style.display='none'; this.parentElement.innerHTML='<div style=&quot;color: rgb(var(--muted-foreground)); font-weight:700; font-size:0.9rem;&quot;>Car photo</div>';"
            />
          </div>
          <div class="meta">
            <div>
              <div class="title">${car.brand} ${car.model}</div>
              <div class="badge">New listing</div>
            </div>
            <div class="price">${car.price}</div>
          </div>
        `;
        return card;
      }

      function renderStack(){
        stack.innerHTML = '';
        cars.forEach((car, idx) => {
          const card = createCard(car, idx);
          stack.appendChild(card);
        });
      }

      function puffMoney(card){
        const puff = document.createElement('div');
        puff.className = 'money-puff';
        puff.textContent = '€';
        card.appendChild(puff);
        puff.addEventListener('animationend', ()=> puff.remove());
      }

      function overlayLoss(card){
        const overlay = document.createElement('div');
        overlay.className = 'overlay-text';
        const line = Math.random() > 0.5 ? 'Missed opportunity' : 'Missed profit';
        overlay.innerHTML = `<span>${line}</span><em>Someone else was faster</em>`;
        card.appendChild(overlay);
        overlay.addEventListener('animationend', ()=> overlay.remove());
      }

      function animateSequence(){
        if(reduceMotion) return; // keep static for accessibility

        const cardsEls = Array.from(stack.querySelectorAll('.hero-card'));
        const order = [...cardsEls.keys()];

        // randomize disappear order for "some earlier, some later"
        order.sort(()=> Math.random() - 0.5);

        let t = 0;
        order.forEach((i, step) => {
          const delay = 300 + Math.random() * 450; // varied timing
          t += delay;

          const card = cardsEls[i];
          setTimeout(() => {
            puffMoney(card);
            overlayLoss(card);
            card.classList.add('is-exiting');
          }, t);
        });

        // restart after last one
        const total = t + 1400;
        setTimeout(() => {
          renderStack();
          animateSequence();
        }, total);
      }

      // init
      renderStack();
      animateSequence();
    })();
  </script>

